---
import '../styles/global.css'
import { client, urlFor } from '../lib/sanity'

interface Props {
	title: string
	description?: string
}

const DEFAULT_DESCRIPTION =
	'Tomas Gonzalez — full-stack engineer focused on AI/ML, backend systems, and cloud infrastructure. See my experience, projects, and skills.'
const OG_TITLE = 'Tomas Gonzalez — Full-Stack & AI/ML Engineer'

const { title, description = DEFAULT_DESCRIPTION } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

interface Profile {
	githubUrl?: string
	linkedinUrl?: string
	resumeFile?: { asset?: { url?: string } }
	avatar?: any
}

const profile = await client.fetch<Profile | null>(
	`*[_type == "profile"][0]{ githubUrl, linkedinUrl, resumeFile{ asset-> { url } }, avatar }`
)

const resumeUrl = profile?.resumeFile?.asset?.url
const ogImageUrl = profile?.avatar
	? urlFor(profile.avatar.asset).width(600).height(600).fit('crop').url()
	: undefined

const sameAs = [profile?.githubUrl, profile?.linkedinUrl].filter(Boolean)
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Tomas Gonzalez',
	url: Astro.site?.toString(),
	jobTitle: 'Full-Stack & AI/ML Engineer',
	...(sameAs.length > 0 && { sameAs }),
}

const navItems = [
	{ href: '#home', label: 'Home' },
	{ href: '#about', label: 'About' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#projects', label: 'Projects' },
	{ href: resumeUrl ?? '/resume', label: 'Resume', external: Boolean(resumeUrl) },
]

const EMAIL = 'thomasgonz67@gmail.com'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · tomasgonzalez</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tomas Gonzalez" />
		<meta property="og:title" content={OG_TITLE} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={OG_TITLE} />
		<meta name="twitter:description" content={description} />
		{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script is:inline>
			const stored = localStorage.getItem('theme')
			if (stored === 'light') document.documentElement.setAttribute('data-theme', 'light')
		</script>
	</head>
	<body>
		<header class="tabbar">
			<nav>
				{navItems.map((item) => (
					<a
						href={item.href}
						data-nav-link={item.href}
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener' : undefined}
						class:list={{ active: !item.external && item.href === '/resume' && Astro.url.pathname === '/resume' }}
					>
						{item.label}
					</a>
				))}
			</nav>
			<button id="theme-toggle" aria-label="Toggle theme">◐</button>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			{profile?.githubUrl && <a href={profile.githubUrl} target="_blank" rel="noopener">GitHub</a>}
			{profile?.linkedinUrl && <a href={profile.linkedinUrl} target="_blank" rel="noopener">LinkedIn</a>}
			<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
			<span class="built-with">(Built by me with Astro and Sanity CMS)</span>
		</footer>
		<script is:inline>
			const root = document.documentElement
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const isLight = root.getAttribute('data-theme') === 'light'
				if (isLight) {
					root.removeAttribute('data-theme')
					localStorage.setItem('theme', 'dark')
				} else {
					root.setAttribute('data-theme', 'light')
					localStorage.setItem('theme', 'light')
				}
			})
		</script>
		<script is:inline>
			const sections = document.querySelectorAll('section[id]')
			const navLinks = document.querySelectorAll('a[data-nav-link^="#"]')

			if (sections.length > 0 && navLinks.length > 0) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								const id = entry.target.getAttribute('id')
								if (window.location.hash !== `#${id}`) {
									history.replaceState(null, '', `#${id}`)
								}
								navLinks.forEach((link) => {
									link.classList.toggle('active', link.getAttribute('data-nav-link') === `#${id}`)
								})
							}
						})
					},
					{ rootMargin: '-40% 0px -55% 0px' }
				)
				sections.forEach((section) => observer.observe(section))
			}
		</script>
	</body>
</html>

<style>
	.tabbar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 24px;
		padding: 12px 20px;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		gap: 4px;
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}
	nav::-webkit-scrollbar {
		display: none;
	}
	nav a {
		flex: none;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--text-muted);
		text-decoration: none;
		padding: 6px 12px;
		border-radius: 4px 4px 0 0;
		border: 1px solid transparent;
		white-space: nowrap;
	}
	@media (max-width: 560px) {
		.tabbar {
			gap: 12px;
			padding: 10px 14px;
		}
		nav {
			gap: 0;
		}
		nav a {
			font-size: 13px;
			padding: 6px 8px;
		}
	}
	nav a:hover {
		color: var(--text);
	}
	nav a.active {
		color: var(--accent);
		background: var(--bg);
		border-color: var(--border);
		border-bottom-color: var(--bg);
		margin-bottom: -1px;
	}
	#theme-toggle {
		background: none;
		border: 1px solid var(--border);
		color: var(--text-muted);
		border-radius: 4px;
		width: 30px;
		height: 30px;
		cursor: pointer;
		font-size: 14px;
	}
	#theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	main {
		padding-bottom: 64px;
	}
	footer {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 20px;
		justify-content: center;
		flex-wrap: wrap;
		padding: 10px 20px;
		background: var(--surface);
		border-top: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 13px;
	}
	footer a {
		color: var(--text-muted);
		text-decoration: none;
	}
	footer a:hover {
		color: var(--accent);
	}
	.built-with {
		position: absolute;
		left: 20px;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted);
		font-size: 12px;
	}
</style>
