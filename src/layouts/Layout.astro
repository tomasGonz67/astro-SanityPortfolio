---
import '../styles/global.css'
import { client, urlFor } from '../lib/sanity'

interface Props {
	title: string
	description?: string
	fullTitle?: string
	extraSchema?: Record<string, unknown>
}

const DEFAULT_DESCRIPTION =
	'Tomas Gonzalez — software engineer and website builder in Holmdel, NJ. I design and build fast, custom websites for businesses across New Jersey, plus full-stack and AI/ML work. See my projects, experience, and freelance services.'
const OG_TITLE = 'Tomas Gonzalez — Software Engineer & Website Builder in Holmdel, NJ'

const { title, description = DEFAULT_DESCRIPTION, fullTitle, extraSchema } = Astro.props
// "Home" wastes the strongest SEO field by putting the page's own name in
// the title instead of what the site is actually about — use the full
// name+role there, and prefix other pages with their own title instead.
// `fullTitle` lets a page set its own complete, SEO-tuned title verbatim.
const pageTitle = fullTitle ?? (title === 'Home' ? OG_TITLE : `${title} | ${OG_TITLE}`)
const canonicalURL = new URL(Astro.url.pathname, Astro.site)

interface Profile {
	githubUrl?: string
	linkedinUrl?: string
	resumeFile?: { asset?: { url?: string } }
	avatar?: any
}

const profile = await client.fetch<Profile | null>(
	`*[_type == "profile"][0]{ githubUrl, linkedinUrl, resumeFile{ asset-> { url } }, avatar }`
)

const resumeUrl = profile?.resumeFile?.asset?.url
const ogImageUrl = profile?.avatar
	? urlFor(profile.avatar.asset).width(600).height(600).fit('crop').url()
	: undefined

const sameAs = [profile?.githubUrl, profile?.linkedinUrl].filter(Boolean)
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Tomas Gonzalez',
	url: Astro.site?.toString(),
	jobTitle: ['Software Engineer', 'Website Builder', 'Full-Stack & AI/ML Engineer'],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Holmdel',
		addressRegion: 'NJ',
		addressCountry: 'US',
	},
	knowsAbout: [
		'Software Engineering',
		'Web Development',
		'Website Design',
		'Astro',
		'React',
		'Cloud Infrastructure',
		'AI/ML',
	],
	...(sameAs.length > 0 && { sameAs }),
}

const navItems = [
	{ href: '#home', label: 'Home' },
	{ href: '#about', label: 'About' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#projects', label: 'Projects' },
	{ href: '/freelance', label: 'Freelance' },
	{ href: resumeUrl ?? '/resume', label: 'Resume', external: Boolean(resumeUrl) },
]

const EMAIL = 'thomasgonz67@gmail.com'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Tomas Gonzalez" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		{extraSchema && <script type="application/ld+json" set:html={JSON.stringify(extraSchema)} />}
		<script is:inline>
			const stored = localStorage.getItem('theme')
			if (stored === 'light') document.documentElement.setAttribute('data-theme', 'light')
		</script>
	</head>
	<body>
		<header class="tabbar">
			<nav>
				{navItems.map((item) => (
					<a
						href={item.href}
						data-nav-link={item.href}
						target={item.external ? '_blank' : undefined}
						rel={item.external ? 'noopener' : undefined}
						class:list={{ active: !item.external && item.href.startsWith('/') && item.href === Astro.url.pathname }}
					>
						{item.label}
					</a>
				))}
			</nav>
			<button id="theme-toggle" aria-label="Toggle theme">◐</button>
		</header>
		<main>
			<slot />
		</main>
		<footer>
			{profile?.githubUrl && (
				<a href={profile.githubUrl} target="_blank" rel="noopener" aria-label="GitHub" class="social-link">
					<span class="link-text">GitHub</span>
					<svg class="link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 .5C5.73.5.5 5.73.5 12c0 5.09 3.29 9.4 7.86 10.93.57.1.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.73 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.25 5.67.41.36.78 1.08.78 2.17 0 1.57-.01 2.83-.01 3.22 0 .31.2.66.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z"></path>
					</svg>
				</a>
			)}
			{profile?.linkedinUrl && (
				<a href={profile.linkedinUrl} target="_blank" rel="noopener" aria-label="LinkedIn" class="social-link">
					<span class="link-text">LinkedIn</span>
					<svg class="link-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"></path>
					</svg>
				</a>
			)}
			<a href={`mailto:${EMAIL}`} aria-label="Email">
				<span class="link-text">{EMAIL}</span>
				<svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<rect x="2" y="4" width="20" height="16" rx="2"></rect>
					<path d="m2 6 10 7 10-7"></path>
				</svg>
			</a>
		</footer>
		<script is:inline>
			const root = document.documentElement
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const isLight = root.getAttribute('data-theme') === 'light'
				if (isLight) {
					root.removeAttribute('data-theme')
					localStorage.setItem('theme', 'dark')
				} else {
					root.setAttribute('data-theme', 'light')
					localStorage.setItem('theme', 'light')
				}
			})
		</script>
		<script is:inline>
			const sections = document.querySelectorAll('section[id]')
			const navLinks = document.querySelectorAll('a[data-nav-link^="#"]')
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

			// Nav links keep a real href="#section" (for right-click / copy-link /
			// middle-click-to-new-tab), but a plain click is intercepted so it
			// scrolls without ever touching the URL — only an explicit click on
			// the browser's own address bar or a shared link should set the hash.
			navLinks.forEach((link) => {
				link.addEventListener('click', (e) => {
					const href = link.getAttribute('data-nav-link')
					const target = href ? document.querySelector(href) : null
					if (!target) return
					e.preventDefault()
					target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth' })
				})
			})

			if (sections.length > 0 && navLinks.length > 0) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								const id = entry.target.getAttribute('id')
								navLinks.forEach((link) => {
									link.classList.toggle('active', link.getAttribute('data-nav-link') === `#${id}`)
								})
							}
						})
					},
					{ rootMargin: '-40% 0px -55% 0px' }
				)
				sections.forEach((section) => observer.observe(section))
			}
		</script>
	</body>
</html>

<style>
	.tabbar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 24px;
		padding: 12px 20px;
		background: var(--surface);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		gap: 4px;
		flex: 1;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
	}
	nav::-webkit-scrollbar {
		display: none;
	}
	nav a {
		flex: none;
		font-family: var(--font-mono);
		font-size: 14px;
		color: var(--text-muted);
		text-decoration: none;
		padding: 6px 12px;
		border-radius: 4px 4px 0 0;
		border: 1px solid transparent;
		white-space: nowrap;
	}
	@media (max-width: 560px) {
		.tabbar {
			gap: 12px;
			padding: 10px 14px;
		}
		nav {
			gap: 0;
		}
		nav a {
			font-size: 13px;
			padding: 6px 8px;
		}
	}
	nav a:hover {
		color: var(--text);
	}
	nav a.active {
		color: var(--accent);
		background: var(--bg);
		border-color: var(--border);
		border-bottom-color: var(--bg);
		margin-bottom: -1px;
	}
	#theme-toggle {
		background: none;
		border: 1px solid var(--border);
		color: var(--text-muted);
		border-radius: 4px;
		width: 30px;
		height: 30px;
		cursor: pointer;
		font-size: 14px;
	}
	#theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	main {
		padding-bottom: 64px;
	}
	footer {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		gap: 20px;
		justify-content: center;
		flex-wrap: wrap;
		padding: 10px 20px;
		background: var(--surface);
		border-top: 1px solid var(--border);
		font-family: var(--font-mono);
		font-size: 13px;
	}
	footer a {
		display: flex;
		align-items: center;
		color: var(--text-muted);
		text-decoration: none;
	}
	footer a:hover {
		color: var(--accent);
	}
	.link-icon {
		display: none;
		width: 25px;
		height: 25px;
	}
	.social-link .link-text {
		display: none;
	}
	.social-link .link-icon {
		display: block;
	}
	@media (max-width: 560px) {
		.link-text {
			display: none;
		}
		.link-icon {
			display: block;
		}
	}
</style>
