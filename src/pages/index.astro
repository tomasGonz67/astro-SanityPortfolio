---
import Layout from '../layouts/Layout.astro'
import { client, urlFor } from '../lib/sanity'

interface SkillTier {
	label: string
	skills: string[]
}

interface Experience {
	_id: string
	company: string
	role: string
	location?: string
	startDate: string
	endDate?: string
	current: boolean
	bullets?: string[]
	techStack?: string[]
	coverImage?: any
	link?: string
	githubUrl?: string
}

interface Project {
	_id: string
	title: string
	description?: string
	coverImage?: any
	techStack?: string[]
	link?: string
	githubUrl?: string
}

interface Profile {
	name: string
	tagline?: string
	roles?: string[]
	skillTiers?: SkillTier[]
	bio?: string
	avatar?: any
	githubUrl?: string
	linkedinUrl?: string
}

const profile = await client.fetch<Profile | null>(
	`*[_type == "profile"][0]{ name, tagline, roles, skillTiers, bio, avatar, githubUrl, linkedinUrl }`
)

const experiences = await client.fetch<Experience[]>(
	`*[_type == "experience"] | order(order asc){
		_id, company, role, location, startDate, endDate, current, bullets, techStack, coverImage, link, githubUrl
	}`
)

const projects = await client.fetch<Project[]>(
	`*[_type == "project"] | order(order asc){
		_id, title, description, coverImage, techStack, link, githubUrl
	}`
)

const roles = profile?.roles ?? ['Full-Stack']

function formatDate(dateStr?: string) {
	if (!dateStr) return ''
	const d = new Date(dateStr)
	return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
}
---

<Layout title="Home">
	<section id="home" class="hero">
		<div class="hero-row">
			{profile?.avatar && (
				<img class="avatar" src={urlFor(profile.avatar).width(240).height(240).url()} alt={profile.name} />
			)}
			<div class="hero-intro">
				<p class="greeting mono">Hi, I'm</p>
			<h1>{profile?.name ?? 'Tomas'}</h1>

				<p class="engineer-line mono">I'm an Engineer</p>
				<p class="typing-line mono">
					<span id="typing-text"></span><span class="cursor">|</span>
				</p>
			</div>
		</div>

		{profile?.tagline && <p>{profile.tagline}</p>}

		<h2 class="section-heading">Skills</h2>

		{profile?.skillTiers && profile.skillTiers.length > 0 ? (
			<div class="skills">
				{profile.skillTiers.map((tier, i) => (
					<div class={`skill-tier tier-${Math.min(i, 2)}`}>
						<p class="tier-label mono">{tier.label}</p>
						<div class="tier-skills">
							{tier.skills.map((skill) => <span class="skill-pill mono">{skill}</span>)}
						</div>
					</div>
				))}
			</div>
		) : (
			<p class="text-muted">Skills snapshot goes here.</p>
		)}
	</section>

	<section id="about">
		<h2 class="section-heading">About Me</h2>

		{!profile && <p class="text-muted">No profile published yet.</p>}

		{profile && (
			<div class="panel about-layout">
				{profile.bio && <p class="bio">{profile.bio}</p>}
			</div>
		)}
	</section>

	<section id="experience">
		<h2 class="section-heading">Experience</h2>

		{experiences.length === 0 && <p class="text-muted">No experience entries published yet.</p>}

		<div class="entries">
			{experiences.map((exp) => (
				<div class="panel entry" data-href={exp.link}>
					<div class="entry-top">
						{exp.coverImage && (
							<img class="thumb" src={urlFor(exp.coverImage.asset).width(360).height(200).fit('max').url()} alt={exp.company} />
						)}
						<div class="entry-head">
							<div>
								<h3>{exp.role}</h3>
								<p class="company">{exp.company}{exp.location && ` · ${exp.location}`}</p>
							</div>
							<p class="dates tabular mono">
								{formatDate(exp.startDate)} – {exp.current ? 'Present' : formatDate(exp.endDate)}
							</p>
						</div>
					</div>
					{exp.bullets && exp.bullets.length > 0 && (
						<ul class="bullets">
							{exp.bullets.map((bullet) => <li>{bullet}</li>)}
						</ul>
					)}
					{exp.techStack && exp.techStack.length > 0 && (
						<div class="tags">
							{exp.techStack.map((tech) => <span class="tag mono">{tech}</span>)}
						</div>
					)}
					{exp.githubUrl && (
						<p class="entry-links mono">
							<a href={exp.githubUrl} target="_blank" rel="noopener">GitHub →</a>
						</p>
					)}
				</div>
			))}
		</div>
	</section>

	<section id="projects">
		<h2 class="section-heading">Projects</h2>

		{projects.length === 0 && <p class="text-muted">No projects published yet.</p>}

		<div class="entries">
			{projects.map((project) => (
				<div class="panel entry" data-href={project.link}>
					{project.coverImage && (
						<img class="cover" src={urlFor(project.coverImage).width(800).height(360).url()} alt={project.title} />
					)}
					<div class="entry-head">
						<h3>{project.title}</h3>
						{project.githubUrl && (
							<p class="entry-links mono">
								<a href={project.githubUrl} target="_blank" rel="noopener">GitHub →</a>
							</p>
						)}
					</div>
					{project.description && <p class="description">{project.description}</p>}
					{project.techStack && project.techStack.length > 0 && (
						<div class="tags">
							{project.techStack.map((tech) => <span class="tag mono">{tech}</span>)}
						</div>
					)}
				</div>
			))}
		</div>
	</section>
</Layout>

<script define:vars={{ roles }}>
	const el = document.getElementById('typing-text')
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

	if (el) {
		if (prefersReducedMotion || roles.length === 0) {
			el.textContent = roles[0] ?? ''
		} else {
			let roleIndex = 0
			let charIndex = 0
			let deleting = false

			const TYPE_SPEED = 70
			const DELETE_SPEED = 35
			const PAUSE_AT_FULL_WORD = 1400
			const PAUSE_AT_EMPTY = 300

			function tick() {
				const current = roles[roleIndex]

				if (!deleting) {
					charIndex++
					el.textContent = current.slice(0, charIndex)
					if (charIndex === current.length) {
						deleting = true
						setTimeout(tick, PAUSE_AT_FULL_WORD)
						return
					}
				} else {
					charIndex--
					el.textContent = current.slice(0, charIndex)
					if (charIndex === 0) {
						deleting = false
						roleIndex = (roleIndex + 1) % roles.length
						setTimeout(tick, PAUSE_AT_EMPTY)
						return
					}
				}
				setTimeout(tick, deleting ? DELETE_SPEED : TYPE_SPEED)
			}

			tick()
		}
	}

	document.querySelectorAll('[data-href]').forEach((card) => {
		card.addEventListener('click', (e) => {
			if (e.target.closest('a')) return
			const href = card.getAttribute('data-href')
			if (href) window.open(href, '_blank', 'noopener')
		})
	})

	const panels = document.querySelectorAll('.panel')
	if (panels.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const target = entry.target
						requestAnimationFrame(() => {
							requestAnimationFrame(() => {
								target.classList.add('in-view')
							})
						})
						revealObserver.unobserve(entry.target)
					}
				})
			},
			{ threshold: 0.15 }
		)
		panels.forEach((panel) => revealObserver.observe(panel))
	}
</script>

<style>
	section {
		padding-top: 48px;
		scroll-margin-top: 64px;
	}
	#home {
		padding-top: 15px;
		min-height: 65vh;
	}
	#home h1 {
		font-size: 44px;
		margin: 0;
	}
	.greeting {
		font-size: 22px;
		color: var(--text-muted);
		margin: 0 0 4px;
	}
	.hero-row {
		display: flex;
		align-items: stretch;
		gap: 28px;
		margin-bottom: 40px;
	}
	.hero-row .avatar {
		flex: none;
		width: auto;
		height: 100%;
		max-width: 220px;
	}
	.hero-intro {
		position: relative;
		display: inline-block;
	}
	@media (max-width: 560px) {
		.hero-row {
			flex-direction: column;
			align-items: center;
		}
		.hero-row .avatar {
			width: 140px;
			height: 140px;
		}
		.hero-intro {
			display: block;
			width: 100%;
			text-align: center;
		}
		#home h1 {
			font-size: 32px;
		}
		.greeting {
			font-size: 18px;
		}
		.engineer-line,
		.typing-line {
			font-size: 24px;
		}
	}
	.hero-intro::before {
		content: '';
		position: absolute;
		inset: -50px;
		background: radial-gradient(ellipse 75% 55% at center, rgba(20, 94, 21, 0.18) 0%, transparent 80%);
		z-index: -1;
	}
	.engineer-line {
		font-size: 34px;
		font-weight: 600;
		color: var(--text);
		margin: 12px 0 0;
	}
	.typing-line {
		font-size: 34px;
		color: var(--text-muted);
		margin: 4px 0 0;
	}
	#typing-text {
		color: var(--accent);
	}
	.cursor {
		color: var(--accent);
		animation: blink 1s step-end infinite;
	}
	@media (prefers-reduced-motion: reduce) {
		.cursor {
			animation: none;
		}
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.text-muted {
		color: var(--text-muted);
	}
	.panel {
		opacity: 0;
		transform: translateY(12px);
		transition: opacity 1s ease, transform 1s ease;
	}
	.panel.in-view {
		opacity: 1;
		transform: translateY(0);
	}
	@media (prefers-reduced-motion: reduce) {
		.panel {
			opacity: 1;
			transform: none;
		}
	}
	.section-heading {
		font-size: 30px;
		color: var(--accent);
		margin: 0 0 20px;
	}
	@media (max-width: 560px) {
		.section-heading {
			text-align: center;
		}
	}
	.skills {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.skill-tier {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 10px;
	}
	.tier-label {
		position: relative;
		display: inline-block;
		font-size: 15px;
		color: var(--text);
		padding-bottom: 6px;
	}
	.tier-label::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		width: 100%;
		background: rgba(52, 199, 89, 0.6);
		transform: scaleX(0);
		transform-origin: left;
		animation: tier-underline 1.6s ease-out forwards;
	}
	.skill-tier:nth-child(2) .tier-label::after {
		animation-delay: 0.35s;
	}
	.skill-tier:nth-child(3) .tier-label::after {
		animation-delay: 0.7s;
	}
	@keyframes tier-underline {
		to {
			transform: scaleX(1);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tier-label::after {
			animation: none;
			transform: scaleX(1);
		}
	}
	.tier-skills {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.skill-pill {
		font-size: 15px;
		padding: 4px 10px;
		border-radius: 4px;
		border: 1px solid rgba(52, 199, 89, 0.2);
		color: var(--text);
	}
	@media (max-width: 560px) {
		.skill-tier {
			align-items: center;
		}
		.tier-skills {
			justify-content: center;
		}
	}

	/* About */
	.about-layout {
		box-shadow: 0 0 16px rgba(52, 199, 89, 0.1);
	}
	.avatar {
		flex: none;
		width: 140px;
		height: 140px;
		border-radius: 50%;
		border: 2px solid rgba(52, 199, 89, 0.6);
		box-shadow: 0 0 16px rgba(52, 199, 89, 0.35);
		object-fit: cover;
	}
	.bio {
		line-height: 1.7;
		white-space: pre-line;
	}

	/* Experience + Projects shared */
	.entries {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}
	.entry {
		box-shadow: 0 0 16px rgba(52, 199, 89, 0.1);
	}
	.entry[data-href] {
		cursor: pointer;
		transition: opacity 1s ease, transform 1s ease, border-color 0.15s ease;
	}
	.entry[data-href]:hover {
		border-color: var(--accent);
	}
	.entry-top {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 12px;
	}
	.thumb {
		flex: none;
		width: 180px;
		height: 100px;
		border-radius: 6px;
		border: 1px solid var(--border);
		background: var(--bg);
		object-fit: contain;
	}
	@media (max-width: 560px) {
		.about-layout,
		.entry {
			text-align: center;
		}
		.entry-top {
			flex-direction: column;
			align-items: center;
		}
		.thumb {
			width: 100%;
			height: auto;
			aspect-ratio: 16 / 9;
		}
		.entry-head {
			justify-content: center;
		}
		.tags {
			justify-content: center;
		}
		.description {
			max-width: none;
		}
	}
	.entry-head {
		flex: 1;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 16px;
		flex-wrap: wrap;
	}
	.entry h3 {
		font-size: 22px;
		margin: 0 0 2px;
		font-family: var(--font-mono);
		font-weight: 600;
	}
	.company {
		color: var(--accent);
		font-size: 16px;
		margin: 0;
	}
	.dates {
		flex: none;
		font-size: 15px;
		color: var(--text-muted);
		white-space: nowrap;
	}
	.bullets {
		margin: 16px 0 0;
		padding-left: 20px;
	}
	.bullets li {
		margin-bottom: 8px;
		line-height: 1.6;
	}
	.bullets li:last-child {
		margin-bottom: 0;
	}
	.cover {
		width: 100%;
		height: auto;
		border-radius: 4px;
		border: 1px solid var(--border);
		margin-bottom: 16px;
		display: block;
	}
	.entry-links {
		flex: none;
		font-size: 13px;
		margin: 0;
	}
	.entry-links a {
		color: var(--accent);
		text-decoration: none;
	}
	.entry-links a:hover {
		text-decoration: underline;
	}
	.description {
		margin: 10px 0 0;
		line-height: 1.6;
		max-width: 65ch;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
	}
	.tag {
		font-size: 12px;
		padding: 3px 9px;
		border-radius: 4px;
		border: 1px solid var(--border);
		color: var(--text-muted);
	}
</style>
