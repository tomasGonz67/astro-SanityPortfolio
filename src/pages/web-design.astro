<Layout
	title="Freelance"
	fullTitle="Holmdel NJ Web Designer & Developer | Tomas Gonzalez"
	description="Freelance web designer in Holmdel, NJ. Custom websites from a free starter page to full web apps, live in 1–2 weeks, and yours to own."
	extraSchema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
	<SectionNav items={sectionItems} />

	<section class="fl-hero" id="top">
		<p class="greeting mono">Freelance web design &amp; development</p>
