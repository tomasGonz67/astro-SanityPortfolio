// Real PageSpeed Insights screenshots, dropped into src/assets/metrics/ and named after the site (cadooga.com.png).
// The 'source' link in the third proof tile appears only when at least one exists.
const metricFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/metrics/*.{png,jpg,jpeg,webp}', { eager: true })
const metricShots = Object.entries(metricFiles)
	.map(([path, mod]) => ({ site: path.split('/').pop()!.replace(/\.(png|jpe?g|webp)$/i, ''), img: mod.default }))
	.sort((a, b) => a.site.localeCompare(b.site))

const sectionItems = [
	{ id: 'top', label: 'Overview' },
	{ id: 'why', label: 'Why hire me' },
	{ id: 'glance', label: 'How I compare' },
	{ id: 'plans', label: 'Plans & pricing' },
	{ id: 'work', label: 'Client work' },
	{ id: 'faq', label: 'FAQ' },
	{ id: 'contact', label: 'Start a project' },
]
