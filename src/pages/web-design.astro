const stories: Array<{
	name: string
	tag: string
	links?: Array<{ label: string; url: string }>
	// A client quote renders only if present. `approved: true` means the named person has confirmed the exact wording;
	// production builds fail on any quote without it (see the guard below).
	quote?: { text: string; name: string; role: string; approved?: boolean }
	before: string[]
	after: string[]
}> = [
	{
		name: 'Cadooga & Vanvir',
		tag: 'Two agency Webflow sites → custom sites on Cloudflare',
		quote: {
			text: 'Having everything in-house is so much simpler than managing Webflow and paying for a bunch of things we didn’t need.',
			name: 'Regina Debellis',
			role: 'CEO, Cadooga',
			approved: true,
		},
		links: [
			{ label: 'cadooga.com', url: 'https://cadooga.com' },
			{ label: 'vanvir.com', url: 'https://vanvir.com' },
		],
		before: [
			'Originally paid ~$10,000 to an agency for just 6 pages across two sites',
			'$500/month in hosting fees for the two sites',
			'Paying for tools they didn’t need — ~8 paid seats (the agency’s whole team) on a basic website',
			'Built on Webflow — slow and awkward to update',
			'A much weaker product for the money',
		],
		after: [
			'<strong>~80% less time</strong> spent updating the site — a much easier workflow',
			'Accessibility issues found and <strong>fixed</strong>',
			'Hosting moved to Cloudflare — <strong>no more $500/month hosting fees</strong>',
			'One-time payment, and they own it',
			'Pay only for what they actually need — nothing extra',
			'Form submissions from both sites are wired into their existing backend and admin dashboard, right next to the rest of their proprietary data',
			'<strong>Saves them money</strong> — no extra form or CRM tool to pay for, since it runs on infrastructure they already had',
		],
	},
	{
		name: 'Madz Photo',
		tag: 'A photographer’s website — plus her whole business setup',
		quote: {
			text: 'Tomas set everything up and made it simple and easy for me, so I can focus on my photography.',
			name: 'Madeline Bitunjac',
			role: 'Owner, Madz Photo',
			approved: true,
		},
		links: [{ label: 'madzphotoco.com', url: 'https://madzphotoco.com' }],
		before: [
			'A new photography business that needed more than a website',
			'No professional email or organized business setup',
			'No clear process from camera to client',
		],
		after: [
			'A custom portfolio site she <strong>owns</strong> — on her own accounts',
			'A <strong>custom booking flow</strong> built exactly to her requests — clients pick a package and date, she approves each booking, with no monthly subscription',
			'<strong>Whole infrastructure set up</strong>: domain and professional email, organized exactly the way she wanted',
			'A clear <strong>photo workflow</strong>: back up originals to offsite storage, edit, and deliver through a gallery service — plus a plan for when to move onto her own delivery, so costs stay low as she grows',
			'<strong>Taught how to use it all and guided her technical decisions</strong> — what to use, what to skip, and when to change course',
		],
	},
]

// Safety net: never publish a quote the named person hasn't approved. Fails a production build (dev still works).
const unapproved = stories.filter((st) => st.quote && !st.quote.approved).map((st) => st.name)
if (import.meta.env.PROD && unapproved.length > 0) {
	throw new Error(`Unapproved client quote for: ${unapproved.join(', ')}. Get the person's OK on the exact wording, then set approved: true (or remove the quote) before building for production.`)
}

const faqs: Array<{ q: string; a: string }> = [
	{
		q: 'Do I need a domain?',
		a: 'Not to get started, but you will want one to launch. A domain is your web address, like yourbusiness.com. Without one, your site only has a long temporary address that customers will not remember. If you already have a domain, I connect it. If not, I can help you pick and register one in your name, so you own it. Domains renew yearly through the registrar. Connecting your domain is included with every plan, and professional email setup is an add-on.',
	},
	{
		q: 'Can you update or maintain an existing website?',
		a: 'Yes. For a site I built, the optional care plan ($75 a month) covers updates, small changes and upkeep, and the first 30 days are free. For a site someone else built, tell me what it runs on and what you need changed. I will tell you honestly whether it makes sense to update it or rebuild it as a site you own.',
	},
	{
		q: 'What do I need to give you to get started?',
		a: 'Just tell me about your business, what features you want on the site, and how you want it to look. That is the real starting point. Then send whatever you already have, like wording, photos, a logo, your domain name, or sites you like. I will tell you if anything else is needed. Timelines start once I have what I need.',
	},
	{
		q: 'Can you move my existing website from Wix, Squarespace, Webflow or WordPress?',
		a: 'Yes. I rebuild an existing site as a custom site that you own, with your content carried over, so you stop paying a builder’s monthly fees. Cadooga and Vanvir were Webflow sites I moved this way.',
	},
	{
		q: 'Can you build a web app, not just a website?',
		a: 'Yes. Besides websites, I build web apps like booking tools, client portals, CRMs, ERPs and dashboards, with a database and a secure login. They start at $8,000 and are scoped to what you need.',
	},
	{
		q: 'Can you build AI, facial recognition or blockchain projects?',
		a: 'Yes. I build AI features like chatbots and smart search, and image or face recognition, by connecting existing AI models to your product. Facial recognition involves biometric privacy laws, so I scope those projects carefully. Blockchain is case by case: tell me what you need and I will say honestly whether I am the right fit. These projects are custom quoted.',
	},
	{
		q: 'Can you guarantee I’ll rank #1 on Google?',
		a: 'Nobody can promise that. What I do is optimize your website’s SEO to give it the best chance. I research what your customers search for and use those words in your titles, headings and page structure. I build fast, mobile-friendly pages, and I add local business details if you serve a specific area. I also submit your site to Google Search Console so Google finds your pages sooner. SEO setup is included with Standard. Where you land still depends on your competition and how long the site has been live.',
	},
	{
		q: 'Do you only work with businesses in New Jersey?',
		a: 'No. I am based in Holmdel, NJ, and I work with clients across Monmouth County, New Jersey and anywhere else.',
	},
]

const breadcrumbSchema = {
