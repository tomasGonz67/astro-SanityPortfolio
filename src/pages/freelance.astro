<script>
	// Same scroll-reveal as the homepage: panels fade + slide up when scrolled
	// into view. Reduced-motion users get them visible immediately (CSS).
	const panels = document.querySelectorAll('.panel')
	if (panels.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const target = entry.target
						requestAnimationFrame(() => {
							requestAnimationFrame(() => target.classList.add('in-view'))
						})
						revealObserver.unobserve(entry.target)
					}
				})
			},
			{ threshold: 0.15 }
		)
		panels.forEach((panel) => revealObserver.observe(panel))
	}

	// "Show the facts" pop-ups: open the matching <dialog>, close via x / Esc / backdrop.
	for (const btn of document.querySelectorAll<HTMLElement>('[data-open]')) {
		btn.addEventListener('click', () => {
			const dlg = document.getElementById(btn.dataset.open ?? '') as HTMLDialogElement | null
			dlg?.showModal()
		})
	}
	for (const dlg of document.querySelectorAll<HTMLDialogElement>('dialog.fl-dialog')) {
		dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close())
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close()
		})
	}
	// "Build your setup" calculator: tick add-ons -> live total + prefilled email.
	const money = (n: number) => '$' + n.toLocaleString()
	for (const form of document.querySelectorAll<HTMLFormElement>('.fl-addon-form')) {
		const dialog = form.closest('dialog')
		if (!dialog) continue
		const base = Number(form.dataset.base) || 0
		const planName = form.dataset.plan ?? ''
		const email = form.dataset.email ?? ''
		const totalEl = dialog.querySelector('.fl-total-amount')
		const cta = dialog.querySelector<HTMLAnchorElement>('.fl-addon-cta')
		const update = () => {
			let once = base
			let perMonth = 0
			let perPage = 0
			let fromFlag = false
			const chosen: string[] = []
			for (const cb of form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
				if (!cb.checked) continue
				const amt = Number(cb.dataset.amount) || 0
				if (cb.dataset.unit === 'mo') perMonth += amt
				else if (cb.dataset.unit === 'page') perPage += amt
				else once += amt
				if (cb.dataset.from === 'true') fromFlag = true
				chosen.push(cb.dataset.name ?? '')
			}
			for (const st of form.querySelectorAll<HTMLElement>('.fl-stepper')) {
				const count = Number(st.querySelector('[data-count]')?.textContent) || 0
				if (!count) continue
				const amt = Number(st.dataset.amount) || 0
				if (st.dataset.unit === 'mo') perMonth += amt * count
				else if (st.dataset.unit === 'page') perPage += amt * count
				else once += amt * count
				chosen.push((st.dataset.name ?? '') + ' ×' + count)
			}
			let text = (fromFlag ? 'from ' : '') + money(once)
			const extras: string[] = []
			if (perMonth) extras.push('+ $' + perMonth + '/mo')
			if (perPage) extras.push('+ $' + perPage + '/page')
			if (extras.length) text += ' ' + extras.join(' ')
			if (totalEl) totalEl.textContent = text
			const body = [
				'Plan: ' + planName,
				'Add-ons: ' + (chosen.length ? chosen.join(', ') : 'none'),
				'Estimate: ' + text,
				'',
				'A bit about my business and what I need:',
			].join('\n')
			if (cta) {
				cta.href =
					'mailto:' + email + '?subject=' + encodeURIComponent('Website project — ' + planName) + '&body=' + encodeURIComponent(body)
			}
		}
		form.addEventListener('change', update)
		const accCb = form.querySelector<HTMLInputElement>('input[data-key="accessibility"]')
		const rider = form.querySelector<HTMLElement>('[data-rider="accessibility"]')
		if (accCb && rider) {
			const syncRider = () => { rider.hidden = !accCb.checked }
			accCb.addEventListener('change', syncRider)
			syncRider()
		}
		for (const btn of form.querySelectorAll<HTMLButtonElement>('.fl-step-btn')) {
			btn.addEventListener('click', () => {
				const countEl = btn.parentElement?.querySelector('[data-count]')
				if (!countEl) return
				const next = Math.max(0, (Number(countEl.textContent) || 0) + Number(btn.dataset.step || 0))
				countEl.textContent = String(next)
				update()
			})
		}
		update()
	}

	// Info "ⓘ" tooltip: a single fixed element positioned by JS so it escapes the
	// modal's overflow and sits above everything. Appended into the open dialog
	// (top layer) when the marker is inside one, otherwise to <body>.
	const tip = document.createElement('div')
	tip.className = 'fl-tip'
	tip.setAttribute('role', 'tooltip')
	const showTip = (marker: HTMLElement) => {
		const text = marker.getAttribute('data-tip')
		if (!text) return
		tip.textContent = text
		const dlg = marker.closest('dialog[open]') as HTMLElement | null
		const host = dlg ?? document.body
		if (tip.parentElement !== host) host.appendChild(tip)
		tip.style.visibility = 'hidden'
		tip.classList.add('show')
		const r = marker.getBoundingClientRect()
		const tw = tip.offsetWidth
		const th = tip.offsetHeight
		let left = r.right - tw
		left = Math.max(8, Math.min(left, window.innerWidth - tw - 8))
		let top = r.bottom + 8
		if (top + th > window.innerHeight - 8) top = r.top - th - 8
		tip.style.left = left + 'px'
		tip.style.top = top + 'px'
		tip.style.visibility = 'visible'
	}
	const hideTip = () => tip.classList.remove('show')
	for (const m of document.querySelectorAll<HTMLElement>('.fl-fee')) {
		m.addEventListener('mouseenter', () => showTip(m))
		m.addEventListener('mouseleave', hideTip)
		m.addEventListener('focus', () => showTip(m))
		m.addEventListener('blur', hideTip)
	}

</script>

