---
import Layout from '../layouts/Layout.astro'

const EMAIL = 'thomasgonz67@gmail.com'
const SITE = 'https://tomasgonz67.com'

// Things a business gets from me that AI builders (Base44, ChatGPT/Claude,
// Wix AI, no-code) can't give them.
const edges = [
	{
		name: 'You own it — pay once',
		ai: 'AI builders host your site for you, as a monthly subscription plus usage credits.',
		limit: 'You rent it forever ($16–$200/mo + credits) and own none of it — stop paying and it’s gone, and you’re locked into their platform.',
		solve: 'I build it once; you own the code and host it anywhere — free up to ~100k requests a day, then about $5/mo. No subscription, no lock-in.',
	},
	{
		name: 'The right solution for your problem',
		ai: 'AI builds exactly what you describe, with whatever stack it defaults to.',
		limit: 'It needs you to already be the architect — it won’t tell you what you actually need, and its default can be slow, pricey, or hit a wall as you grow.',
		solve: 'I start from your business problem, then pick and tune the stack for your cost, performance, and growth. No overpaying, no walls.',
	},
	{
		name: 'Accessibility & ADA',
		ai: 'AI generators output markup that looks finished.',
		limit: 'It’s almost never accessible — and most owners don’t know ADA applies to websites. Over 4,000 web-accessibility lawsuits hit U.S. businesses in 2025, most of them small or mid-sized, and settling typically runs $5,000–$25,000 plus legal fees — even if you fix the site afterward.',
		solve: 'I build and test to WCAG 2.1 AA — automated scans plus hands-on manual testing (keyboard and screen reader) — so it genuinely meets the standard, not just looks finished.',
	},
	{
		name: 'Security, tested',
		ai: 'AI produces code that runs and looks fine.',
		limit: 'It routinely leaves leaked keys, insecure forms, no spam/rate-limiting, and mishandled data — and won’t flag its own holes.',
		solve: 'I build it secure and test for the vulnerabilities before real customers and their data ever touch it.',
	},
	{
		name: 'Compliance-aware',
		ai: 'AI builds the page; compliance isn’t its job and it won’t bring it up.',
		limit: 'Privacy policy, cookie consent, terms, email rules, ADA — a layperson with AI doesn’t know these exist until there’s a problem.',
		solve: 'I build to them, and flag when you genuinely need a lawyer.',
	},
	{
		name: 'Real engineering judgment',
		ai: 'AI generates code fast and confidently from your prompt.',
		limit: 'That code is often subtly broken, insecure, or unscalable — and the AI can’t tell. When it breaks, a non-dev is stuck.',
		solve: 'I know when it’s wrong, fix it, and make it maintainable — and I use AI myself to move fast.',
	},
]

const plans = [
	{
		name: 'Starter Site',
		price: 'from $600',
		blurb: 'A clean, custom one-page site to get your business online fast.',
		points: ['Single high-converting page', 'Mobile-first & fast', 'Contact form', 'Live in ~1–2 weeks'],
	},
	{
		name: 'Business Website',
		price: 'from $1,800',
		blurb: 'A multi-page site with a CMS you can update yourself.',
		points: ['Multi-page custom build', 'Easy self-edit CMS', 'Built for SEO', 'Contact / booking forms'],
	},
	{
		name: 'Redesign / Migration',
		price: 'from $1,200',
		blurb: 'Move off Wix, Squarespace, or an old site onto something fast and yours.',
		points: ['Rebuilt on a modern stack', 'Keep your content & SEO', 'Faster load times', 'Own your code'],
	},
	{
		name: 'Web App / Custom Software',
		price: 'custom quote',
		blurb: 'Dashboards, portals, internal tools, automations, AI features — scoped to you.',
		points: ['Full-stack web apps', 'Automations & integrations', 'AI features', 'Built by a senior engineer'],
	},
]

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Tomas Gonzalez — Freelance Web Development',
	description:
		'Custom website design and development for small businesses — a website builder and web developer in Holmdel, NJ, serving Monmouth County and across New Jersey. Also web apps and custom software.',
	url: `${SITE}/freelance`,
	provider: { '@type': 'Person', name: 'Tomas Gonzalez', url: SITE },
	areaServed: [
		{ '@type': 'City', name: 'Holmdel' },
		{ '@type': 'AdministrativeArea', name: 'Monmouth County' },
		{ '@type': 'State', name: 'New Jersey' },
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Holmdel',
		addressRegion: 'NJ',
		addressCountry: 'US',
	},
	serviceType: [
		'Website design',
		'Web development',
		'Website redesign',
		'CMS website',
		'Website builder',
		'Web application development',
		'Custom software',
	],
	priceRange: '$$',
}
---

<Layout
	title="Freelance"
	fullTitle="Website Builder & Web Developer in NJ · Tomas Gonzalez"
	description="Freelance website builder and web developer in Holmdel, NJ. I build fast, custom websites — plus web apps and custom software — for businesses across Monmouth County and New Jersey. Built to own and easy to update."
	extraSchema={serviceSchema}
>
	<section class="fl-hero">
		<p class="greeting mono">Freelance web development</p>
		<h1>Website builder &amp; web developer in Holmdel, NJ</h1>
		<p class="fl-lede">
			I build fast, custom <strong>websites</strong> — plus <strong>web apps and custom software</strong> — for small
			businesses and professionals across Holmdel, Monmouth County, and New Jersey. Modern, mobile-first, easy to update,
			and built to own. One person, start to finish: the one who builds it is the one you talk to.
		</p>
		<a class="fl-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Get a free quote →</a>
	</section>

	<section class="fl-block">
		<h2 class="section-heading">Why hire me in the age of AI</h2>
		<p class="fl-lede fl-intro">
			When AI tools like Base44 can build a website in minutes, and ChatGPT or Claude can crank out code in seconds — why
			pay a person? Because AI alone can't give you this:
		</p>
		<div class="fl-grid">
			{
				edges.map((e) => (
					<div class="panel fl-card">
						<h3>{e.name}</h3>
						<div class="fl-step">
							<span class="fl-step-label">How AI does it</span>
							<p>{e.ai}</p>
						</div>
						<div class="fl-step">
							<span class="fl-step-label">Limitations of this</span>
							<p>{e.limit}</p>
						</div>
						<div class="fl-step fl-step-solve">
							<span class="fl-step-label">Problem I solve</span>
							<p>{e.solve}</p>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="fl-block">
		<h2 class="section-heading">My plans</h2>
		<div class="fl-grid">
			{
				plans.map((p) => (
					<div class="panel fl-card">
						<div class="fl-card-head">
							<h3>{p.name}</h3>
							<span class="fl-price mono">{p.price}</span>
						</div>
						<p class="fl-blurb">{p.blurb}</p>
						<ul class="fl-points mono">
							{p.points.map((pt) => (
								<li>{pt}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p class="fl-note mono text-muted">
			+ ongoing care &amp; updates from $75/mo · Intro pricing while I build my portfolio — every project gets a custom quote.
		</p>
	</section>

	<section class="fl-block">
		<h2 class="section-heading">Selected work</h2>
		<div class="panel">
			<p>A few recent builds — more on the <a href="/#projects">projects</a> section of my site.</p>
			<ul class="fl-list">
				<li><strong>Cadooga / Vanvir</strong> — marketing sites migrated to Astro on Cloudflare.</li>
				<li><strong>Madz Photo</strong> — a photographer's portfolio and booking site.</li>
				<li><strong>Tapse</strong> — a product site with a real staging workflow.</li>
			</ul>
		</div>
	</section>

	<section class="fl-block fl-contact">
		<h2 class="section-heading">Start a project</h2>
		<div class="panel">
			<p>Tell me about your business and what you need — I'll reply with ideas and a quote.</p>
			<a class="fl-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Email me →</a>
		</div>
	</section>
</Layout>

<script>
	// Same scroll-reveal as the homepage: panels fade + slide up when scrolled
	// into view. Reduced-motion users get them visible immediately (CSS).
	const panels = document.querySelectorAll('.panel')
	if (panels.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const target = entry.target
						requestAnimationFrame(() => {
							requestAnimationFrame(() => target.classList.add('in-view'))
						})
						revealObserver.unobserve(entry.target)
					}
				})
			},
			{ threshold: 0.15 }
		)
		panels.forEach((panel) => revealObserver.observe(panel))
	}
</script>

<style>
	.fl-hero {
		position: relative;
		padding-block: 1rem 1rem;
	}
	.fl-hero::before {
		content: '';
		position: absolute;
		inset: -40px -30px;
		background: radial-gradient(ellipse 70% 60% at 25% 45%, rgba(20, 94, 21, 0.18) 0%, transparent 80%);
		z-index: -1;
		pointer-events: none;
	}
	.fl-hero h1 {
		margin: 0.25rem 0 1rem;
		max-width: 20ch;
	}
	.fl-lede {
		max-width: 62ch;
		opacity: 0.85;
		line-height: 1.6;
	}
	.fl-intro {
		margin: 0 0 1.5rem;
	}
	.fl-cta {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.75rem 1.3rem;
		border: 1px solid currentColor;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		transition: opacity 0.15s ease;
	}
	.fl-cta:hover {
		opacity: 0.7;
	}

	/* scroll-reveal + hover, matching the homepage */
	.panel {
		opacity: 0;
		transform: translateY(12px);
		transition: opacity 1s ease, transform 1s ease;
		box-shadow: 0 0 16px rgba(52, 199, 89, 0.1);
	}
	.panel.in-view {
		opacity: 1;
		transform: translateY(0);
	}
	.fl-card {
		transition: opacity 1s ease, transform 1s ease, border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.fl-card:hover {
		border-color: var(--accent);
		box-shadow: 0 0 20px rgba(52, 199, 89, 0.22);
	}
	@media (prefers-reduced-motion: reduce) {
		.panel {
			opacity: 1;
			transform: none;
		}
	}

	.fl-block {
		margin-top: 3rem;
	}
	.fl-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.fl-card h3 {
		margin: 0 0 0.4rem;
	}
	.fl-step {
		margin-top: 0.8rem;
	}
	.fl-step-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.55;
		margin-bottom: 0.15rem;
	}
	.fl-step p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
		opacity: 0.9;
	}
	.fl-step-solve .fl-step-label {
		color: var(--accent);
		opacity: 1;
	}
	.fl-step-solve p {
		opacity: 1;
	}
	.fl-card-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 0.4rem;
	}
	.fl-card-head h3 {
		margin: 0;
	}
	.fl-price {
		font-size: 0.85rem;
		font-weight: 600;
		opacity: 0.9;
		white-space: nowrap;
	}
	.fl-blurb {
		margin: 0;
		opacity: 0.85;
		line-height: 1.5;
	}
	.fl-card .fl-blurb {
		margin-bottom: 0;
	}
	.fl-points {
		margin: 0.9rem 0 0;
		padding-left: 1.1rem;
		font-size: 0.85rem;
		opacity: 0.8;
		display: grid;
		gap: 0.3rem;
	}
	.fl-list {
		margin: 0.5rem 0 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.6rem;
		line-height: 1.55;
	}
	.fl-note {
		margin-top: 1rem;
		font-size: 0.82rem;
	}
	@media (max-width: 640px) {
		.fl-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
