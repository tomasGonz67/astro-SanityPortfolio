---
import Layout from '../layouts/Layout.astro'

const EMAIL = 'thomasgonz67@gmail.com'
const SITE = 'https://tomasgonz67.com'

// NOTE: intro placeholder pricing — Tomas to confirm/adjust the numbers.
const plans = [
	{
		name: 'Starter Site',
		price: 'from $600',
		blurb: 'A clean, custom one-page site to get your business online fast.',
		points: ['Single high-converting page', 'Mobile-first & fast', 'Contact form', 'Live in ~1–2 weeks'],
	},
	{
		name: 'Business Website',
		price: 'from $1,800',
		blurb: 'A multi-page site with a CMS you can update yourself.',
		points: ['Multi-page custom build', 'Easy self-edit CMS', 'Built for SEO', 'Contact / booking forms'],
	},
	{
		name: 'Redesign / Migration',
		price: 'from $1,200',
		blurb: 'Move off Wix, Squarespace, or an old site onto something fast and yours.',
		points: ['Rebuilt on a modern stack', 'Keep your content & SEO', 'Faster load times', 'Own your code'],
	},
	{
		name: 'Web App / Custom Software',
		price: 'custom quote',
		blurb: 'Dashboards, portals, internal tools, automations, AI features — scoped to you.',
		points: ['Full-stack web apps', 'Automations & integrations', 'AI features', 'Built by a senior engineer'],
	},
]

const moats = [
	{
		name: 'Accessibility & ADA',
		blurb: 'Built to WCAG 2.1 AA — reaches every customer and shields you from the web-accessibility lawsuits most AI and template sites are wide open to.',
	},
	{
		name: 'Security, tested',
		blurb: 'No leaked keys, open forms, spam floods, or mishandled data. I build it secure and check for the holes AI quietly leaves behind.',
	},
	{
		name: 'The right solution for your problem',
		blurb: 'I start from what your business needs to do, then pick and tune the stack for your cost, performance, and growth — not a template or an AI default. No overpaying, no walls when you scale.',
	},
	{
		name: 'Compliance-aware',
		blurb: 'ADA, privacy policy, cookie consent, terms, email rules — built to them, with a heads-up when you genuinely need a lawyer. A layperson with AI doesn’t know these exist.',
	},
	{
		name: 'Real engineering judgment',
		blurb: 'AI writes code that looks right and is subtly broken, insecure, or unscalable — and can’t tell. I know when it’s wrong, and I fix it.',
	},
]

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Tomas Gonzalez — Freelance Web Development',
	description:
		'Custom website design and development for small businesses — a website builder and web developer in Holmdel, NJ, serving Monmouth County and across New Jersey. Also web apps and custom software.',
	url: `${SITE}/freelance`,
	provider: { '@type': 'Person', name: 'Tomas Gonzalez', url: SITE },
	areaServed: [
		{ '@type': 'City', name: 'Holmdel' },
		{ '@type': 'AdministrativeArea', name: 'Monmouth County' },
		{ '@type': 'State', name: 'New Jersey' },
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Holmdel',
		addressRegion: 'NJ',
		addressCountry: 'US',
	},
	serviceType: [
		'Website design',
		'Web development',
		'Website redesign',
		'CMS website',
		'Website builder',
		'Web application development',
		'Custom software',
	],
	priceRange: '$$',
}
---

<Layout
	title="Freelance"
	fullTitle="Website Builder & Web Developer in NJ · Tomas Gonzalez"
	description="Freelance website builder and web developer in Holmdel, NJ. I build fast, custom websites — plus web apps and custom software — for businesses across Monmouth County and New Jersey. Built to own and easy to update."
	extraSchema={serviceSchema}
>
	<!-- Summary / hook (always visible) -->
	<section class="fl-hero">
		<p class="greeting mono">Freelance web development</p>
		<h1>Website builder &amp; web developer in Holmdel, NJ</h1>
		<p class="fl-lede">
			I build fast, custom <strong>websites</strong> — plus <strong>web apps and custom software</strong> — for small
			businesses and professionals across Holmdel, Monmouth County, and New Jersey. Modern, mobile-first, easy to update,
			and built to own. One person, start to finish: the one who builds it is the one you talk to.
		</p>
		<a class="fl-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Get a free quote →</a>
	</section>

	<!-- Trigger cards (each opens a pop-up dialog) -->
	<div class="fl-section">
		<div class="fl-summary">
			<div class="fl-summary-text">
				<h2 class="section-heading">Why choose me?</h2>
				<p class="fl-summary-desc">What sets me apart from an agency, a DIY builder, or just using AI.</p>
			</div>
			<button type="button" class="fl-toggle" data-open="dlg-why">See more →</button>
		</div>
	</div>

	<div class="fl-section">
		<div class="fl-summary">
			<div class="fl-summary-text">
				<h2 class="section-heading">What AI can't give you</h2>
				<p class="fl-summary-desc">Accessibility, security, compliance, and judgment — the parts AI and templates skip.</p>
			</div>
			<button type="button" class="fl-toggle" data-open="dlg-moats">See more →</button>
		</div>
	</div>

	<div class="fl-section">
		<div class="fl-summary">
			<div class="fl-summary-text">
				<h2 class="section-heading">My plans</h2>
				<p class="fl-summary-desc">Packages and starting prices — from a one-page site to a custom web app.</p>
			</div>
			<button type="button" class="fl-toggle" data-open="dlg-plans">See more →</button>
		</div>
	</div>

	<div class="fl-section">
		<div class="fl-summary">
			<div class="fl-summary-text">
				<h2 class="section-heading">Selected work</h2>
				<p class="fl-summary-desc">A few recent sites and apps I've built for clients.</p>
			</div>
			<button type="button" class="fl-toggle" data-open="dlg-work">See more →</button>
		</div>
	</div>

	<!-- Contact (always visible) -->
	<section class="fl-contact">
		<h2 class="section-heading">Start a project</h2>
		<div class="panel">
			<p>Tell me about your business and what you need — I'll reply with ideas and a quote.</p>
			<a class="fl-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Email me →</a>
		</div>
	</section>

	<!-- Pop-up dialogs -->
	<dialog class="fl-dialog" id="dlg-why" aria-labelledby="dlg-why-title">
		<div class="fl-dialog-inner">
			<div class="fl-dialog-head">
				<h2 id="dlg-why-title" class="section-heading">Why choose me?</h2>
				<button type="button" class="fl-dialog-close" data-close aria-label="Close">✕</button>
			</div>
			<div class="fl-why-grid">
				<div class="panel">
					<h3>Over the alternatives</h3>
					<ul class="fl-list">
						<li><strong>You work with me, not a sales team.</strong> No handoffs, no account-manager markup — faster answers, built by the person you actually hired.</li>
						<li><strong>Custom, not a template.</strong> Hand-coded on a modern stack — loads fast, ranks better, and doesn't look like every other Squarespace site.</li>
						<li><strong>You own everything.</strong> Your domain, your code, your content — no monthly platform rent, no lock-in.</li>
						<li><strong>Local.</strong> Based in Holmdel, NJ — a real person down the road, not an overseas agency.</li>
						<li><strong>A senior engineer.</strong> I also build full apps and software, so your site is built right — not just dragged and dropped.</li>
					</ul>
				</div>
				<div class="panel">
					<h3>In the age of AI</h3>
					<ul class="fl-list">
						<li><strong>AI builders give you a guess.</strong> Wix AI, ChatGPT site generators, and no-code tools spit out generic, templated sites that break the moment you need something specific — and you're renting them.</li>
						<li><strong>AI builds whatever you ask — I figure out what you actually need.</strong> Then I pick and tune the stack for your budget, speed, and growth, instead of whatever the AI defaults to.</li>
						<li><strong>I use AI to move faster, not to think for me.</strong> It speeds up the busywork and keeps your cost down; the judgment, the custom logic, the performance, and the ownership come from a real engineer.</li>
						<li><strong>The result is actually yours.</strong> Fast, custom, and built to do what your business needs — not a cookie-cutter guess you're stuck paying for every month.</li>
					</ul>
				</div>
			</div>
		</div>
	</dialog>

	<dialog class="fl-dialog" id="dlg-moats" aria-labelledby="dlg-moats-title">
		<div class="fl-dialog-inner">
			<div class="fl-dialog-head">
				<h2 id="dlg-moats-title" class="section-heading">What AI can't give you</h2>
				<button type="button" class="fl-dialog-close" data-close aria-label="Close">✕</button>
			</div>
			<div class="fl-grid">
				{
					moats.map((m) => (
						<div class="panel fl-card">
							<h3>{m.name}</h3>
							<p class="fl-blurb">{m.blurb}</p>
						</div>
					))
				}
			</div>
		</div>
	</dialog>

	<dialog class="fl-dialog" id="dlg-plans" aria-labelledby="dlg-plans-title">
		<div class="fl-dialog-inner">
			<div class="fl-dialog-head">
				<h2 id="dlg-plans-title" class="section-heading">My plans</h2>
				<button type="button" class="fl-dialog-close" data-close aria-label="Close">✕</button>
			</div>
			<div class="fl-grid">
				{
					plans.map((p) => (
						<div class="panel fl-card">
							<div class="fl-card-head">
								<h3>{p.name}</h3>
								<span class="fl-price mono">{p.price}</span>
							</div>
							<p class="fl-blurb">{p.blurb}</p>
							<ul class="fl-points mono">
								{p.points.map((pt) => (
									<li>{pt}</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
			<p class="fl-note mono text-muted">
				+ ongoing care &amp; updates from $75/mo · Intro pricing while I build my portfolio — every project gets a custom quote.
			</p>
		</div>
	</dialog>

	<dialog class="fl-dialog" id="dlg-work" aria-labelledby="dlg-work-title">
		<div class="fl-dialog-inner">
			<div class="fl-dialog-head">
				<h2 id="dlg-work-title" class="section-heading">Selected work</h2>
				<button type="button" class="fl-dialog-close" data-close aria-label="Close">✕</button>
			</div>
			<div class="panel">
				<p>A few recent builds — more on the <a href="/#projects">projects</a> section of my site.</p>
				<ul class="fl-list">
					<li><strong>Cadooga / Vanvir</strong> — marketing sites migrated to Astro on Cloudflare.</li>
					<li><strong>Madz Photo</strong> — a photographer's portfolio and booking site.</li>
					<li><strong>Tapse</strong> — a product site with a real staging workflow.</li>
				</ul>
			</div>
		</div>
	</dialog>
</Layout>

<script>
	// Open the matching <dialog> as a modal; close via the ✕, Esc (native), or a backdrop click.
	for (const btn of document.querySelectorAll<HTMLElement>('[data-open]')) {
		btn.addEventListener('click', () => {
			const dlg = document.getElementById(btn.dataset.open ?? '') as HTMLDialogElement | null
			dlg?.showModal()
		})
	}
	for (const dlg of document.querySelectorAll<HTMLDialogElement>('dialog.fl-dialog')) {
		dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close())
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close() // click on the backdrop area
		})
	}
</script>

<style>
	.fl-hero {
		padding-block: 1rem 2.5rem;
	}
	.fl-hero h1 {
		margin: 0.25rem 0 1rem;
		max-width: 20ch;
	}
	.fl-lede {
		max-width: 62ch;
		opacity: 0.85;
		line-height: 1.6;
	}
	.fl-cta {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.75rem 1.3rem;
		border: 1px solid currentColor;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		transition: opacity 0.15s ease;
	}
	.fl-cta:hover {
		opacity: 0.7;
	}

	/* Trigger cards */
	.fl-section {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 6px 24px;
		margin-bottom: 16px;
	}
	.fl-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.75rem;
	}
	.fl-summary h2 {
		margin: 0;
	}
	.fl-summary-text {
		min-width: 0;
	}
	.fl-summary-desc {
		margin: 0.3rem 0 0;
		font-size: 0.9rem;
		opacity: 0.75;
		line-height: 1.4;
	}
	.fl-toggle {
		flex: none;
		display: inline-flex;
		align-items: center;
		background: none;
		color: var(--accent);
		border: 1px solid var(--accent);
		border-radius: 8px;
		padding: 0.45rem 0.9rem;
		font-family: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		white-space: nowrap;
		cursor: pointer;
		transition: opacity 0.15s ease;
	}
	.fl-toggle:hover {
		opacity: 0.7;
	}

	/* Pop-up dialogs */
	.fl-dialog {
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		color: inherit;
		width: calc(100% - 2rem);
		max-width: 680px;
		max-height: 85vh;
		overflow: hidden;
	}
	.fl-dialog::backdrop {
		background: rgba(0, 0, 0, 0.55);
	}
	.fl-dialog-inner {
		padding: 24px;
		max-height: 85vh;
		overflow-y: auto;
	}
	.fl-dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.1rem;
	}
	.fl-dialog-head h2 {
		margin: 0;
	}
	.fl-dialog-close {
		flex: none;
		background: none;
		border: none;
		color: inherit;
		font-size: 1.1rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0.6;
		padding: 0.3rem;
	}
	.fl-dialog-close:hover {
		opacity: 1;
	}
	/* inside a dialog: panels transparent (no box-in-box), grids single column */
	.fl-dialog .panel {
		background: transparent;
	}
	.fl-dialog .fl-why-grid,
	.fl-dialog .fl-grid {
		grid-template-columns: 1fr;
	}

	.fl-why-grid,
	.fl-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.fl-card-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 0.4rem;
	}
	.fl-card-head h3 {
		margin: 0;
	}
	.fl-card h3 {
		margin: 0 0 0.4rem;
	}
	.fl-price {
		font-size: 0.85rem;
		font-weight: 600;
		opacity: 0.9;
		white-space: nowrap;
	}
	.fl-blurb {
		margin: 0 0 0.9rem;
		opacity: 0.85;
	}
	.fl-points {
		margin: 0;
		padding-left: 1.1rem;
		font-size: 0.85rem;
		opacity: 0.8;
		display: grid;
		gap: 0.3rem;
	}
	.fl-list {
		margin: 0.5rem 0 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.6rem;
		line-height: 1.55;
	}
	.fl-why-grid h3 {
		margin-top: 0;
	}
	.fl-note {
		margin-top: 1rem;
		font-size: 0.82rem;
	}
	.fl-contact {
		margin-top: 1.5rem;
	}
	@media (max-width: 640px) {
		.fl-why-grid,
		.fl-grid {
			grid-template-columns: 1fr;
		}
		.fl-summary {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.6rem;
		}
	}
</style>
