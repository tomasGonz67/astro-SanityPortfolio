		}
	}

	/* scroll-reveal + hover, matching the homepage */
	.panel {
		opacity: 0;
		transform: translateY(12px);
		transition: opacity 1s ease, transform 1s ease;
		box-shadow: 0 0 16px rgba(52, 199, 89, 0.1);
	}
	.panel.in-view {
