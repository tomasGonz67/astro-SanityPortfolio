---
import Layout from '../layouts/Layout.astro'

const EMAIL = 'thomasgonz67@gmail.com'
const SITE = 'https://tomasgonz67.com'

// Things a business gets from me that AI builders (Base44, ChatGPT/Claude,
// Wix AI, no-code) can't give them.
const edges: Array<{ name: string; ai: string; limit: string; solve: string; why?: string; fact?: string; source?: string; sourceUrl?: string; process?: string }> = [
	{
		name: 'You own it — pay once',
		ai: 'AI builders host your site for you, on a subscription plus usage credits.',
		limit: 'You rent it forever and own none of it. Stop paying, and it’s gone.',
		solve: 'I build it once; you own the code and host it anywhere for next to nothing. No subscription, no lock-in.',
		why: 'You pay a builder every month, forever, for a site you don’t own — and can’t take with you.',
		fact: 'Base44 (now Wix-owned) and similar AI builders run <strong>$16–$200/mo</strong> plus usage credits that don’t roll over. Cloudflare hosting for a static site is <strong>free up to ~100k requests a day, then about $5/mo</strong>.',
		source: 'Base44 pricing',
		sourceUrl: 'https://base44.com/blog/how-much-does-base44-cost',
		process: 'I hand over everything, in your name: the code in your own repo, your domain, your Cloudflare hosting, and every other service it uses (CMS, email, etc.). It’s yours to keep, move, or hand to another developer — no leash.',
	},
	{
		name: 'Avoid ADA lawsuits',
		ai: 'AI generators output markup that looks finished.',
		limit: 'It’s almost never accessible — and most owners don’t know ADA applies to websites, leaving them open to accessibility lawsuits.',
		solve: 'I build and test to WCAG 2.1 AA, so it genuinely meets the standard — not just looks finished.',
		why: 'An inaccessible site is a lawsuit waiting to happen — and settling costs real money even if you fix it afterward.',
		fact: 'Industry trackers logged <strong>~4,000+ U.S. web-accessibility lawsuits in 2025</strong> (UsableNet, Seyfarth, EcomBack), most against small and mid-sized businesses. Settling a demand letter commonly runs <strong>$5,000–$25,000 plus legal fees</strong>, and "overlay" widgets don’t stop the suits.',
		source: 'EcomBack 2025 ADA website-accessibility lawsuit report',
		sourceUrl: 'https://www.ecomback.com/annual-2025-ada-website-accessibility-lawsuit-report',
		process: 'I run automated accessibility scans (axe-core and WAVE) across the build, then test by hand — full keyboard navigation, a screen-reader pass, focus order, color contrast, reflow, and status messages — all against WCAG 2.1 AA.',
	},
	{
		name: 'Security, tested',
		ai: 'AI produces code that runs and looks fine.',
		limit: 'It routinely ships with security holes it never flags — until they bite.',
		solve: 'I build it secure and test for the vulnerabilities before real customers and their data ever touch it.',
		why: 'A breach, a spam flood, or leaked customer data lands on you — not the tool that wrote the code.',
		fact: 'A 2025 Veracode study found AI-generated code introduced a <strong>security vulnerability about 45% of the time</strong> — leaked API keys, unvalidated forms, and missing spam/rate-limiting, the stuff the tools don’t flag in their own output.',
		source: 'Veracode — AI-generated code security risks',
		sourceUrl: 'https://www.veracode.com/blog/ai-generated-code-security-risks/',
		process: 'I keep secrets in environment variables (never in the code); validate, sanitize, and rate-limit every input against spam and abuse; protect and test against common attacks like XSS and injection; enforce security headers and HTTPS; and scan dependencies for known vulnerabilities and keep them patched.',
	},
	{
		name: 'A consultant, not just a coder',
		ai: 'AI code tools — Claude, ChatGPT, Copilot — generate code fast, but only what you ask, and only as good as the prompt.',
		limit: 'Turning that into a real, working system takes architecture and system-design experience it can’t give you.',
		solve: 'I’m your technical consultant: I learn your business, architect the right system, and steer the AI to build it — direction, not just code.',
		why: 'A slow, generic build quietly loses you customers and search rankings — speed is money.',
		fact: 'Google found <strong>53% of mobile visitors leave a site that takes more than 3 seconds to load</strong>; faster pages convert better; and page speed (Core Web Vitals) is a Google ranking factor.',
		source: 'Google — “The Need for Mobile Speed” (via Make It Loud research summary)',
		sourceUrl: 'https://makeitloud.net/research/milliseconds-make-millions/',
		process: 'Because I use these tools daily, I know how to steer AI and LLMs to produce precise, efficient results — not generic guesses. And the way I build — static-first on a fast stack — means your site typically loads in under a second, well under Google’s 3-second bar — without trading away features, accessibility, or SEO to get there.',
	},
	{
		name: 'Custom-built, no ceiling',
		ai: 'AI site builders — Wix, Squarespace, Base44 — assemble your site from their pre-set blocks, themes, and features.',
		limit: 'You’re boxed into what the platform allows — their layouts, their features, their plan tiers. Want something they didn’t build? You can’t have it.',
		solve: 'It’s custom code — no ceiling: any design, any feature, even a full web app, scaling as big as you grow.',
		why: 'Outgrow a builder and you don’t upgrade — you <strong>rebuild from scratch</strong>.',
		fact: 'A builder can only do what its editor and app marketplace allow, so anything past a basic site — a real database, a dashboard or admin panel, file storage, user accounts, automations, or a full web app like a booking or planning system — is off the table or capped by your plan tier.',
		process: 'I build whatever your business actually needs — the site, plus any database, dashboard, file storage, integrations, or custom system (a booking tool, a planning system, a client portal) it calls for. I handle all of it, and hand it over as yours.',
	},
	{
		name: 'Compliance-aware',
		ai: 'AI builds the page; compliance isn’t its job and it won’t bring it up.',
		limit: 'A site can trigger legal obligations most owners don’t even know exist — until there’s a problem.',
		solve: 'I build to them, and flag when you genuinely need a lawyer.',
		why: '<strong>The fines or complaints land on your business, not the builder</strong> — and most AI builders address none of it.',
		fact: 'Depending on who you serve, a site can trigger privacy-policy, cookie-consent (GDPR/CCPA), terms-of-service, email (CAN-SPAM), and ADA obligations. Some carry real teeth: under the CAN-SPAM Act, every marketing email that breaks the rules can draw an FTC penalty of up to <strong>$53,088 — per email, with no cap</strong>.',
		source: 'CAN-SPAM penalty ($53,088/email), per FTC inflation adjustment',
		sourceUrl: 'https://www.adaptivesecurity.com/blog/email-compliance-penalties',
		process: 'I build to the ones that apply — privacy policy, cookie consent, and safe handling of any form data — and flag clearly when something genuinely needs a lawyer. I’m not one, and I’ll tell you when you need one.',
	},
]

// unit: 'once' (default) one-time $, 'mo' recurring $/mo, 'page' per-page $.
// from: true means the amount is a starting estimate.
type AddOn = {
	name: string
	price: string
	amount: number
	unit?: 'mo' | 'page'
	from?: boolean
	qty?: boolean
	key?: string // marks a trigger item (e.g. 'accessibility')
	accessibilityRider?: boolean // show "+ accessibility" when the accessibility item is ticked
	fee?: string // hover note: may carry a third-party subscription/fee, paid to that service
}
const FEE_NOTE = 'Might come with an additional subscription fee, depending on the tools you choose \u2014 paid to that service, not to me.'
const plans: Array<{
	name: string
	price: string
	base?: number
	blurb: string
	points: string[]
	badge?: string
	featured?: boolean
	custom?: boolean
	fee?: string
	addons?: AddOn[]
}> = [
	{
		name: 'Starter Page',
		price: 'Free',
		base: 0,
		blurb: 'A clean, custom single-page site to get you online — on me. Add what you need from there.',
		points: ['Single static page', 'Mobile-first & fast', 'Yours to own'],
		addons: [
			{ name: 'Extra page', price: '$125/page', amount: 125, qty: true },
			{ name: 'Self-edit CMS', price: '$750', amount: 750 },
			{ name: 'SEO setup', price: '$750', amount: 750 },
			{ name: 'Accessibility (ADA) audit', price: '$1,000', amount: 1000, key: 'accessibility' },
			{ name: 'Contact form', price: '$150', amount: 150 },
			{ name: 'Booking / scheduling', price: 'from $400', amount: 400, from: true, fee: FEE_NOTE },
			{ name: 'Legal pages (privacy + terms)', price: '$150', amount: 150, accessibilityRider: true },
			{ name: 'Blog / news section', price: '$600', amount: 600 },
			{ name: 'Payments / Buy button', price: '$300', amount: 300, fee: FEE_NOTE },
			{ name: 'Integration / automation', price: 'from $300', amount: 300, from: true, fee: FEE_NOTE },
			{ name: 'AI chatbot / assistant', price: 'from $750', amount: 750, from: true, fee: FEE_NOTE },
			{ name: 'Analytics & tracking', price: '$100', amount: 100 },
			{ name: 'Domain & email setup', price: '$150', amount: 150, fee: FEE_NOTE },
			{ name: 'Ongoing care & updates', price: '$75/mo', amount: 75, unit: 'mo' },
		],
	},
	{
		name: 'Standard Website',
		price: '$3,000',
		base: 3000,
		badge: 'Best Value',
		featured: true,
		blurb: 'A custom multi-page site — accessible, built for search, and editable by you.',
		points: [
			'1–5 custom pages',
			'ADA-compliant, with accessibility statement',
			'SEO-optimized',
			'Free, self-edit CMS',
			'Contact form',
			'Starter legal pages (privacy + terms)',
		],
		addons: [
			{ name: 'Extra page (beyond 5)', price: '$50/page', amount: 50, qty: true },
			{ name: 'Booking / scheduling', price: 'from $300', amount: 300, from: true, fee: FEE_NOTE },
			{ name: 'Blog / news section', price: '$300', amount: 300 },
			{ name: 'Payments / Buy button', price: '$200', amount: 200, fee: FEE_NOTE },
			{ name: 'Integration / automation', price: 'from $200', amount: 200, from: true, fee: FEE_NOTE },
			{ name: 'AI chatbot / assistant', price: 'from $500', amount: 500, from: true, fee: FEE_NOTE },
			{ name: 'Analytics & tracking', price: '$50', amount: 50 },
			{ name: 'Domain & email setup', price: '$50', amount: 50, fee: FEE_NOTE },
			{ name: 'Ongoing care & updates', price: '$75/mo', amount: 75, unit: 'mo' },
		],
	},
	{
		name: 'Small Online Store',
		price: 'from $2,500+',
		badge: 'Limited-time offer',
		custom: true,
		fee: FEE_NOTE,
		blurb: 'A clean storefront for a focused catalog — product pages, cart, and secure checkout, built into your own site.',
		points: ['Storefront + product pages', 'Cart & secure checkout', 'Self-edit product CMS', 'Yours to own'],
	},
	{
		name: 'Medium Online Store',
		price: 'from $5,000+',
		badge: 'Limited-time offer',
		custom: true,
		fee: FEE_NOTE,
		blurb: 'A larger store with variants, inventory, discounts, shipping & tax — scoped to your catalog.',
		points: ['Larger catalog & variants', 'Inventory & discounts', 'Shipping & tax setup', 'Integrations & automations'],
	},
	{
		name: 'Small Web App',
		price: 'from $8,000+',
		custom: true,
		blurb: 'One core system — a booking tool, client portal, dashboard, or internal tool — with a database and secure login.',
		points: ['Custom full-stack build', 'Database + user login', 'One core workflow', 'Built by a senior engineer'],
	},
	{
		name: 'Medium Web App',
		price: 'from $20,000+',
		custom: true,
		blurb: 'A real product: multiple features, user accounts, integrations, automations, and AI — scoped to you.',
		points: ['Multi-feature product', 'User accounts & roles', 'Integrations & automations', 'AI features'],
	},
]

// Each feature is 'inc' (included), 'add' (available add-on), or literal text.
const compare: Array<{ feature: string; free: string; standard: string; note?: string }> = [
	{ feature: 'Pages', free: '1 static', standard: '1–5' },
	{ feature: 'Custom design', free: 'inc', standard: 'inc' },
	{ feature: 'Mobile-first & fast', free: 'inc', standard: 'inc' },
	{ feature: 'Yours to own', free: 'inc', standard: 'inc' },
	{ feature: 'Self-edit CMS', free: '$750', standard: 'inc' },
	{ feature: 'SEO setup', free: '$750', standard: 'inc' },
	{ feature: 'Accessibility (ADA)', free: '$1,000', standard: 'inc' },
	{ feature: 'Contact form', free: '$150', standard: 'inc' },
	{ feature: 'Booking / scheduling', free: 'from $400', standard: 'from $300' },
	{ feature: 'Legal pages (privacy + terms)', free: '$150', standard: 'inc' },
	{ feature: 'Blog or news section', free: '$600', standard: '$300' },
	{ feature: 'Payments / Buy button', free: '$300', standard: '$200' },
	{ feature: 'Integration / automation', free: 'from $300', standard: 'from $200' },
	{ feature: 'AI chatbot / assistant', free: 'from $750', standard: 'from $500' },
	{ feature: 'Analytics & tracking', free: '$100', standard: '$50' },
	{ feature: 'Domain & professional email', free: '$150', standard: '$50' },
	{ feature: 'Ongoing care & updates', free: '$75/mo', standard: '$75/mo' },
]

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Tomas Gonzalez — Freelance Web Development',
	description:
		'Custom website design and development for small businesses — a website builder and web developer in Holmdel, NJ, serving Monmouth County and across New Jersey. Also web apps and custom software.',
	url: `${SITE}/freelance`,
	provider: { '@type': 'Person', name: 'Tomas Gonzalez', url: SITE },
	areaServed: [
		{ '@type': 'City', name: 'Holmdel' },
		{ '@type': 'AdministrativeArea', name: 'Monmouth County' },
		{ '@type': 'State', name: 'New Jersey' },
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Holmdel',
		addressRegion: 'NJ',
		addressCountry: 'US',
	},
	serviceType: [
		'Website design',
		'Web development',
		'Website redesign',
		'CMS website',
		'Website builder',
		'Web application development',
		'Custom software',
	],
	priceRange: '$$',
}
---

<Layout
	title="Freelance"
	fullTitle="Website Builder & Web Developer in NJ · Tomas Gonzalez"
	description="Freelance website builder and web developer in Holmdel, NJ. I build fast, custom websites — plus web apps and custom software — for businesses across Monmouth County and New Jersey. Built to own and easy to update."
	extraSchema={serviceSchema}
>
	<section class="fl-hero">
		<p class="greeting mono">Freelance web development</p>
		<h1>Website builder &amp; web developer in Holmdel, NJ</h1>
		<p class="fl-lede">
			I build fast, custom <strong>websites</strong> — plus <strong>web apps and custom software</strong> — for businesses and
			professionals, from a first storefront to an established company. Based in Holmdel, NJ. I work with clients located anywhere. Modern, mobile-first, easy to update,
			and built to own. One person, start to finish: the one who builds it is the one you talk to — senior-level work, without the agency overhead.
		</p>
		<a class="fl-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Get a free quote →</a>
	</section>

	<section class="fl-proof-strip">
		<div class="fl-proof-grid">
			<div class="panel fl-proof">
				<p class="fl-proof-value">Agency work, freelancer price</p>
				<p class="fl-proof-note">The strategy, custom design, and build an agency gives you — quoted flat and upfront, priced like a freelancer, not a firm.</p>
				<p class="fl-proof-bench">Agencies charge <strong>$6,000–$35,000+</strong> for the same scope <a href="https://gruffygoat.com/blog/small-business-website-cost" target="_blank" rel="noopener">source</a></p>
			</div>
			<div class="panel fl-proof">
				<p class="fl-proof-value">Live in 1–2 weeks</p>
				<p class="fl-proof-note">I build websites start to finish in a week or two — one person, nothing stuck in a queue waiting on a team.</p>
				<p class="fl-proof-bench">Typical agencies take <strong>6–12 weeks</strong> <a href="https://blacksmith.agency/resources/web-design/how-long-it-takes-design-website/" target="_blank" rel="noopener">source</a></p>
			</div>
			<div class="panel fl-proof">
				<p class="fl-proof-value">Yours, forever</p>
				<p class="fl-proof-note">Accessible, secure, and loads in under a second — and hosted for just a few dollars a month.</p>
				<p class="fl-proof-bench">Builder subscriptions run <strong>$16–$200/mo</strong>, forever <a href="https://base44.com/blog/how-much-does-base44-cost" target="_blank" rel="noopener">source</a></p>
			</div>
		</div>
	</section>

	<section class="fl-block">
		<h2 class="section-heading">Why hire me in the age of AI</h2>
		<p class="fl-lede fl-intro">
			When AI tools like Base44 can build a website in minutes, and ChatGPT or Claude can crank out code in seconds — why
			pay a person? Because AI alone can't give you this:
		</p>
		<div class="fl-grid">
			{
				edges.map((e, i) => (
					<div class="panel fl-card" data-open={e.why || e.fact || e.process ? `facts-${i}` : undefined}>
						<h3>{e.name}</h3>
						<div class="fl-step">
							<span class="fl-step-label">How AI does it</span>
							<p>{e.ai}</p>
						</div>
						<div class="fl-step">
							<span class="fl-step-label">Limitations of this</span>
							<p>{e.limit}</p>
						</div>
						<div class="fl-step fl-step-solve">
							<span class="fl-step-label">Problem I solve</span>
							<p>{e.solve}</p>
						</div>
						{(e.why || e.fact || e.process) && (
							<button type="button" class="fl-facts-btn">More details →</button>
						)}
					</div>
				))
			}
		</div>
		{
			edges.map((e, i) =>
				e.why || e.fact || e.process ? (
					<dialog class="fl-dialog" id={`facts-${i}`} aria-labelledby={`facts-${i}-title`}>
						<div class="fl-dialog-inner">
							<div class="fl-dialog-head">
								<button type="button" class="fl-dialog-close" data-close aria-label="Close">✕</button>
							</div>
							{e.why && (
								<div class="fl-step">
									<span class="fl-step-label">Why it matters</span>
									<p set:html={e.why}></p>
								</div>
							)}
							{e.fact && (
								<div class="fl-step">
									<span class="fl-step-label">Fact</span>
									<p set:html={e.fact}></p>
									{e.sourceUrl && (
										<p class="fl-source">
											<a href={e.sourceUrl} target="_blank" rel="noopener">source</a>
										</p>
									)}
								</div>
							)}
							{e.process && (
								<div class="fl-step">
									<span class="fl-step-label">My process</span>
									<p>{e.process}</p>
								</div>
							)}
							<h3 id={`facts-${i}-title`} class="section-heading fl-dialog-title-bottom">{e.name}</h3>
						</div>
					</dialog>
				) : null
			)
		}
	</section>

	<section class="fl-block">
		<h2 class="section-heading">My plans</h2>
		<div class="fl-grid">
			{
				plans.map((p, i) => (
					<div class="panel fl-card" class:list={{ 'fl-plan-featured': p.featured, 'fl-plan-badged': p.badge }}>
						{p.badge && <span class:list={['fl-plan-badge mono', { 'fl-plan-badge-offer': !p.featured }]}>{p.badge}</span>}
						<div class="fl-card-head">
							<h3>{p.name}</h3>
							<span class="fl-price mono">
								{p.price}
								{p.fee && <span class="fl-fee" data-tip={p.fee} tabindex="0" role="note" aria-label={p.fee}>ⓘ</span>}
							</span>
						</div>
						<p class="fl-blurb">{p.blurb}</p>
						<ul class="fl-points mono">
							{p.points.map((pt) => (
								<li>{pt}</li>
							))}
						</ul>
						{p.addons && (
							<button type="button" class="fl-addons-btn mono" data-open={`addons-${i}`}>
								+ Add-ons &amp; pricing
							</button>
						)}
						{p.custom && <p class="fl-card-custom mono">Fully custom — everything scoped into your quote.</p>}
					</div>
				))
			}
			<div class="panel fl-card fl-cta-card">
				<h3>Something else entirely?</h3>
				<p class="fl-blurb">A one-of-a-kind app, an ambitious idea, or something that doesn’t fit a box above — that’s my favorite kind of project. Tell me what you’re imagining and we’ll scope it together.</p>
				<a class="fl-cta" href={`mailto:${EMAIL}?subject=Custom%20project`}>Let’s talk →</a>
			</div>
		</div>

		{
			plans.map((p, i) =>
				p.addons ? (
					<dialog class="fl-dialog fl-addon-dialog" id={`addons-${i}`} aria-labelledby={`addons-${i}-title`}>
						<div class="fl-dialog-inner">
							<div class="fl-dialog-head">
								<h3 id={`addons-${i}-title`} class="fl-addon-dialog-title">{p.name} — build your setup</h3>
								<button type="button" class="fl-dialog-close" data-close aria-label="Close">✕</button>
							</div>
							<p class="fl-addon-dialog-sub mono">Starts at {p.price} · tick what you'd like to add</p>
							<form class="fl-addon-form" data-base={String(p.base ?? 0)} data-plan={p.name} data-email={EMAIL}>
								<ul class="fl-addon-options">
									{p.addons.map((a) =>
										a.qty ? (
											<li class="fl-opt fl-opt-qty">
												<span class="fl-opt-name">
													{a.name} <span class="fl-opt-per mono">+ {a.price}</span>
												</span>
												<div
													class="fl-stepper"
													data-amount={String(a.amount)}
													data-unit={a.unit ?? 'once'}
													data-name={a.name}
												>
													<button type="button" class="fl-step-btn" data-step="-1" aria-label={`Fewer ${a.name}`}>−</button>
													<span class="fl-step-n mono" data-count>0</span>
													<button type="button" class="fl-step-btn" data-step="1" aria-label={`More ${a.name}`}>+</button>
												</div>
											</li>
										) : (
											<li>
												<label class="fl-opt">
													<input
														type="checkbox"
														data-amount={String(a.amount)}
														data-unit={a.unit ?? 'once'}
														data-name={a.name}
														data-from={a.from ? 'true' : 'false'}
														data-key={a.key}
													/>
													<span class="fl-opt-name">
														{a.name}
														{a.fee && <span class="fl-fee" data-tip={a.fee} tabindex="0" role="note" aria-label={a.fee}>ⓘ</span>}
														{a.accessibilityRider && (
															<span class="fl-rider" data-rider="accessibility" hidden> + accessibility</span>
														)}
													</span>
													<span class="fl-opt-price mono">+ {a.price}</span>
												</label>
											</li>
										)
									)}
								</ul>
							</form>
							<div class="fl-addon-total">
								<span class="fl-total-label mono">Estimate</span>
								<span class="fl-total-amount mono">{p.base ? `$${p.base.toLocaleString()}` : '$0'}</span>
							</div>
							<a class="fl-cta fl-addon-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Email me this setup →</a>
						</div>
					</dialog>
				) : null
			)
		}
		<div class="panel fl-assurance">
			<p class="fl-assurance-head mono">Included with every paid plan</p>
			<ul class="fl-assurance-list">
				<li>Built &amp; security-tested before launch</li>
				<li>Free security &amp; dependency patches for critical vulnerabilities</li>
				<li>90-day warranty</li>
				<li>30 days of free maintenance</li>
			</ul>
			<p class="fl-assurance-head mono fl-assurance-head-2">Included in every plan</p>
