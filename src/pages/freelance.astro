---
import Layout from '../layouts/Layout.astro'

const EMAIL = 'thomasgonz67@gmail.com'
const SITE = 'https://tomasgonz67.com'

// Things a business gets from me that AI builders (Base44, ChatGPT/Claude,
// Wix AI, no-code) can't give them.
const edges: Array<{ name: string; ai: string; limit: string; solve: string; facts?: string; process?: string }> = [
	{
		name: 'You own it — pay once',
		ai: 'AI builders host your site for you, as a monthly subscription plus usage credits.',
		limit: 'You rent it forever — a monthly subscription plus credits — and own none of it. Stop paying and it’s gone.',
		solve: 'I build it once; you own the code and host it anywhere for next to nothing. No subscription, no lock-in.',
		facts: 'Base44 (now owned by Wix) and similar AI builders run on monthly subscriptions ($16–$200/mo) plus usage credits that don’t roll over — and your site lives on their platform. Cloudflare hosting for a static site is free up to ~100k requests a day, then about $5/mo.',
		process: 'I hand over everything, in your name: the code in your own repo, your domain, your Cloudflare hosting, and every other service it uses (CMS, email, etc.). It’s yours to keep, move, or hand to another developer — no leash.',
	},
	{
		name: 'A consultant, not just a coder',
		ai: 'AI only builds what you ask, with whatever stack it defaults to — it’s only ever as good as the prompt you give it.',
		limit: 'It doesn’t understand your business, so it can’t tell you what to build or pick the right approach — and its default can be slow, pricey, or hit a wall as you grow. You have to already be the architect.',
		solve: 'I act as your technical consultant: I learn your business, recommend the right approach, and pick and tune the stack for your cost, performance, and growth — and I know how to steer AI to build it precisely. Advice and direction, not just code.',
		facts: 'The right stack shows up as speed — and speed is money. Google found 53% of mobile visitors leave a site that takes more than 3 seconds to load; faster pages convert better; and page speed (Core Web Vitals) is a Google ranking factor. The sites I build typically load in under a second — well under that bar.',
		process: 'We start with a short discovery call about what your business actually needs to do. I map the requirements, recommend the simplest approach that fits your budget and growth, and scope it before any code. Because I use these tools daily, I also know how to steer AI and LLMs to produce precise, efficient results — not generic guesses.',
	},
	{
		name: 'Accessibility & ADA',
		ai: 'AI generators output markup that looks finished.',
		limit: 'It’s almost never accessible — and most owners don’t know ADA applies to websites, leaving them open to accessibility lawsuits.',
		solve: 'I build and test to WCAG 2.1 AA, so it genuinely meets the standard — not just looks finished.',
		facts: 'Industry trackers logged ~4,000+ U.S. web-accessibility lawsuits in 2025 (UsableNet, Seyfarth, EcomBack), most against small and mid-sized businesses. Settling a demand letter commonly runs $5,000–$25,000 plus legal fees — even if you fix the site afterward. And accessibility "overlay" widgets don’t stop the suits.',
		process: 'Automated scan (axe-core) wired into the build, then manual testing: full keyboard navigation, a screen-reader pass, focus order, color contrast, reflow, and status messages — all checked against WCAG 2.1 AA.',
	},
	{
		name: 'Security, tested',
		ai: 'AI produces code that runs and looks fine.',
		limit: 'It routinely ships with security holes it never flags — until they bite.',
		solve: 'I build it secure and test for the vulnerabilities before real customers and their data ever touch it.',
		facts: 'Leaked API keys, unvalidated forms, and no spam/rate-limiting are among the most common issues in AI-generated and no-code sites — and the tools don’t flag their own holes.',
		process: 'Secrets kept in environment variables (never in the code), form inputs validated and rate-limited against spam/abuse, security headers and HTTPS enforced, and dependencies checked for known vulnerabilities before launch.',
	},
	{
		name: 'Compliance-aware',
		ai: 'AI builds the page; compliance isn’t its job and it won’t bring it up.',
		limit: 'A site can trigger legal obligations most owners don’t even know exist — until there’s a problem.',
		solve: 'I build to them, and flag when you genuinely need a lawyer.',
		facts: 'Depending on who you serve, a site can trigger privacy-policy, cookie-consent (GDPR/CCPA), terms-of-service, email (CAN-SPAM), and ADA obligations. Most AI builders address none of them.',
		process: 'I build to the ones that apply — privacy policy, cookie consent, and safe handling of any form data — and flag clearly when something genuinely needs a lawyer. I’m not one, and I’ll tell you when you need one.',
	},
]

const plans = [
	{
		name: 'Starter Site',
		price: 'from $600',
		blurb: 'A clean, custom one-page site to get your business online fast.',
		points: ['Single high-converting page', 'Mobile-first & fast', 'Contact form', 'Live in ~1–2 weeks'],
	},
	{
		name: 'Business Website',
		price: 'from $1,800',
		blurb: 'A multi-page site with a CMS you can update yourself.',
		points: ['Multi-page custom build', 'Easy self-edit CMS', 'Built for SEO', 'Contact / booking forms'],
	},
	{
		name: 'Redesign / Migration',
		price: 'from $1,200',
		blurb: 'Move off Wix, Squarespace, or an old site onto something fast and yours.',
		points: ['Rebuilt on a modern stack', 'Keep your content & SEO', 'Faster load times', 'Own your code'],
	},
	{
		name: 'Web App / Custom Software',
		price: 'custom quote',
		blurb: 'Dashboards, portals, internal tools, automations, AI features — scoped to you.',
		points: ['Full-stack web apps', 'Automations & integrations', 'AI features', 'Built by a senior engineer'],
	},
]

const serviceSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Tomas Gonzalez — Freelance Web Development',
	description:
		'Custom website design and development for small businesses — a website builder and web developer in Holmdel, NJ, serving Monmouth County and across New Jersey. Also web apps and custom software.',
	url: `${SITE}/freelance`,
	provider: { '@type': 'Person', name: 'Tomas Gonzalez', url: SITE },
	areaServed: [
		{ '@type': 'City', name: 'Holmdel' },
		{ '@type': 'AdministrativeArea', name: 'Monmouth County' },
		{ '@type': 'State', name: 'New Jersey' },
	],
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Holmdel',
		addressRegion: 'NJ',
		addressCountry: 'US',
	},
	serviceType: [
		'Website design',
		'Web development',
		'Website redesign',
		'CMS website',
		'Website builder',
		'Web application development',
		'Custom software',
	],
	priceRange: '$$',
}
---

<Layout
	title="Freelance"
	fullTitle="Website Builder & Web Developer in NJ · Tomas Gonzalez"
	description="Freelance website builder and web developer in Holmdel, NJ. I build fast, custom websites — plus web apps and custom software — for businesses across Monmouth County and New Jersey. Built to own and easy to update."
	extraSchema={serviceSchema}
>
	<section class="fl-hero">
		<p class="greeting mono">Freelance web development</p>
		<h1>Website builder &amp; web developer in Holmdel, NJ</h1>
		<p class="fl-lede">
			I build fast, custom <strong>websites</strong> — plus <strong>web apps and custom software</strong> — for small
			businesses and professionals across Holmdel, Monmouth County, and New Jersey. Modern, mobile-first, easy to update,
			and built to own. One person, start to finish: the one who builds it is the one you talk to — senior-level work, without the agency overhead.
		</p>
		<a class="fl-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Get a free quote →</a>
	</section>

	<section class="fl-block">
		<h2 class="section-heading">Why hire me in the age of AI</h2>
		<p class="fl-lede fl-intro">
			When AI tools like Base44 can build a website in minutes, and ChatGPT or Claude can crank out code in seconds — why
			pay a person? Because AI alone can't give you this:
		</p>
		<div class="fl-grid">
			{
				edges.map((e, i) => (
					<div class="panel fl-card" data-open={e.facts || e.process ? `facts-${i}` : undefined}>
						<h3>{e.name}</h3>
						<div class="fl-step">
							<span class="fl-step-label">How AI does it</span>
							<p>{e.ai}</p>
						</div>
						<div class="fl-step">
							<span class="fl-step-label">Limitations of this</span>
							<p>{e.limit}</p>
						</div>
						<div class="fl-step fl-step-solve">
							<span class="fl-step-label">Problem I solve</span>
							<p>{e.solve}</p>
						</div>
						{(e.facts || e.process) && (
							<button type="button" class="fl-facts-btn">More details →</button>
						)}
					</div>
				))
			}
		</div>
		{
			edges.map((e, i) =>
				e.facts || e.process ? (
					<dialog class="fl-dialog" id={`facts-${i}`} aria-labelledby={`facts-${i}-title`}>
						<div class="fl-dialog-inner">
							<div class="fl-dialog-head">
								<h3 id={`facts-${i}-title`} class="section-heading">{e.name}</h3>
								<button type="button" class="fl-dialog-close" data-close aria-label="Close">✕</button>
							</div>
							{e.facts && (
								<div class="fl-step">
									<span class="fl-step-label">The facts</span>
									<p>{e.facts}</p>
								</div>
							)}
							{e.process && (
								<div class="fl-step">
									<span class="fl-step-label">My process</span>
									<p>{e.process}</p>
								</div>
							)}
						</div>
					</dialog>
				) : null
			)
		}
	</section>

	<section class="fl-block">
		<h2 class="section-heading">My plans</h2>
		<div class="fl-grid">
			{
				plans.map((p) => (
					<div class="panel fl-card">
						<div class="fl-card-head">
							<h3>{p.name}</h3>
							<span class="fl-price mono">{p.price}</span>
						</div>
						<p class="fl-blurb">{p.blurb}</p>
						<ul class="fl-points mono">
							{p.points.map((pt) => (
								<li>{pt}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
		<p class="fl-note mono text-muted">
			+ ongoing care &amp; updates from $75/mo · Intro pricing while I build my portfolio — every project gets a custom quote.
		</p>
	</section>

	<section class="fl-block">
		<h2 class="section-heading">Selected work</h2>
		<div class="panel">
			<p>A few recent builds — more on the <a href="/#projects">projects</a> section of my site.</p>
			<ul class="fl-list">
				<li><strong>Cadooga / Vanvir</strong> — marketing sites migrated to Astro on Cloudflare.</li>
				<li><strong>Madz Photo</strong> — a photographer's portfolio and booking site.</li>
				<li><strong>Tapse</strong> — a product site with a real staging workflow.</li>
			</ul>
		</div>
	</section>

	<section class="fl-block fl-contact">
		<h2 class="section-heading">Start a project</h2>
		<div class="panel">
			<p>Tell me about your business and what you need — I'll reply with ideas and a quote.</p>
			<a class="fl-cta" href={`mailto:${EMAIL}?subject=Website%20project`}>Email me →</a>
		</div>
	</section>
</Layout>

<script>
	// Same scroll-reveal as the homepage: panels fade + slide up when scrolled
	// into view. Reduced-motion users get them visible immediately (CSS).
	const panels = document.querySelectorAll('.panel')
	if (panels.length > 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const revealObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const target = entry.target
						requestAnimationFrame(() => {
							requestAnimationFrame(() => target.classList.add('in-view'))
						})
						revealObserver.unobserve(entry.target)
					}
				})
			},
			{ threshold: 0.15 }
		)
		panels.forEach((panel) => revealObserver.observe(panel))
	}

	// "Show the facts" pop-ups: open the matching <dialog>, close via x / Esc / backdrop.
	for (const btn of document.querySelectorAll<HTMLElement>('[data-open]')) {
		btn.addEventListener('click', () => {
			const dlg = document.getElementById(btn.dataset.open ?? '') as HTMLDialogElement | null
			dlg?.showModal()
		})
	}
	for (const dlg of document.querySelectorAll<HTMLDialogElement>('dialog.fl-dialog')) {
		dlg.querySelector('[data-close]')?.addEventListener('click', () => dlg.close())
		dlg.addEventListener('click', (e) => {
			if (e.target === dlg) dlg.close()
		})
	}
</script>

<style>
	.fl-hero {
		position: relative;
		padding-block: 1rem 1rem;
	}
	.fl-hero::before {
		content: '';
		position: absolute;
		inset: -40px -30px;
		background: radial-gradient(ellipse 70% 60% at 25% 45%, rgba(20, 94, 21, 0.18) 0%, transparent 80%);
		z-index: -1;
		pointer-events: none;
	}
	.fl-hero h1 {
		margin: 0.25rem 0 1rem;
		max-width: 20ch;
	}
	.fl-lede {
		max-width: 62ch;
		opacity: 0.85;
		line-height: 1.6;
	}
	.fl-intro {
		margin: 0 0 1.5rem;
	}
	.fl-cta {
		display: inline-block;
		margin-top: 1.5rem;
		padding: 0.75rem 1.3rem;
		border: 1px solid currentColor;
		border-radius: 8px;
		text-decoration: none;
		font-weight: 600;
		transition: opacity 0.15s ease;
	}
	.fl-cta:hover {
		opacity: 0.7;
	}

	/* scroll-reveal + hover, matching the homepage */
	.panel {
		opacity: 0;
		transform: translateY(12px);
		transition: opacity 1s ease, transform 1s ease;
		box-shadow: 0 0 16px rgba(52, 199, 89, 0.1);
	}
	.panel.in-view {
		opacity: 1;
		transform: translateY(0);
	}
	.fl-card {
		transition: opacity 1s ease, transform 1s ease, border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.fl-card:hover {
		border-color: var(--accent);
		box-shadow: 0 0 20px rgba(52, 199, 89, 0.22);
	}
	@media (prefers-reduced-motion: reduce) {
		.panel {
			opacity: 1;
			transform: none;
		}
	}

	.fl-block {
		margin-top: 3rem;
	}
	.fl-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.fl-card h3 {
		margin: 0 0 0.4rem;
	}
	.fl-step {
		margin-top: 0.8rem;
	}
	.fl-step-label {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		opacity: 0.55;
		margin-bottom: 0.15rem;
	}
	.fl-step p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
		opacity: 0.9;
	}
	.fl-step-solve .fl-step-label {
		color: var(--accent);
		opacity: 1;
	}
	.fl-step-solve p {
		opacity: 1;
	}
	.fl-card[data-open] {
		cursor: pointer;
	}
	.fl-facts-btn {
		margin-top: 1rem;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.fl-facts-btn:hover {
		opacity: 0.7;
	}
	.fl-dialog {
		padding: 0;
		border: 1px solid var(--border);
		border-radius: 10px;
		background: var(--surface);
		color: inherit;
		width: calc(100% - 2rem);
		max-width: 560px;
		max-height: 85vh;
		overflow: hidden;
	}
	.fl-dialog::backdrop {
		background: rgba(0, 0, 0, 0.55);
	}
	.fl-dialog-inner {
		padding: 24px;
		max-height: 85vh;
		overflow-y: auto;
	}
	.fl-dialog-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}
	.fl-dialog-head h3 {
		margin: 0;
	}
	.fl-dialog-close {
		flex: none;
		background: none;
		border: none;
		color: inherit;
		font-size: 1.1rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0.6;
		padding: 0.3rem;
	}
	.fl-dialog-close:hover {
		opacity: 1;
	}
	.fl-card-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 0.4rem;
	}
	.fl-card-head h3 {
		margin: 0;
	}
	.fl-price {
		font-size: 0.85rem;
		font-weight: 600;
		opacity: 0.9;
		white-space: nowrap;
	}
	.fl-blurb {
		margin: 0;
		opacity: 0.85;
		line-height: 1.5;
	}
	.fl-card .fl-blurb {
		margin-bottom: 0;
	}
	.fl-points {
		margin: 0.9rem 0 0;
		padding-left: 1.1rem;
		font-size: 0.85rem;
		opacity: 0.8;
		display: grid;
		gap: 0.3rem;
	}
	.fl-list {
		margin: 0.5rem 0 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.6rem;
		line-height: 1.55;
	}
	.fl-note {
		margin-top: 1rem;
		font-size: 0.82rem;
	}
	@media (max-width: 640px) {
		.fl-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
