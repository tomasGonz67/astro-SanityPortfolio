		transform: translateY(0);
	}
	.fl-card {
		transition: opacity 1s ease, transform 1s ease, border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.fl-card:hover {
		border-color: var(--accent);
		box-shadow: 0 0 20px rgba(52, 199, 89, 0.22);
	}
	@media (prefers-reduced-motion: reduce) {
		.panel {
			opacity: 1;
			transform: none;
		}
	}

	.fl-block {
		margin-top: 3rem;
	}
	.fl-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.fl-card h3 {
		margin: 0 0 0.4rem;
	}
	.fl-step {
		margin-top: 0.8rem;
	}
	.fl-step-label {
